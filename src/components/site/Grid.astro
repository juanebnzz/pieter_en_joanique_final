---
/**
 * The page grid. Outer wrapper carries the horizontal margins (20px phone,
 * 40px tablet, 80px desktop); the inner element carries the max-width and
 * the 12 columns (from lg), with no horizontal padding of its own — so the
 * measure never shrinks as the viewport grows. Content stops at 1680px and
 * the margins grow beyond that.
 *
 * Children place themselves with lg:col-start-* / lg:col-span-*. Below lg
 * it is a one-column grid — still a grid, so order-* and gap-y-* work on
 * phones (block flow would ignore both).
 */
import type { HTMLTag, Polymorphic } from 'astro/types';

type Props<Tag extends HTMLTag = 'div'> = Polymorphic<{ as: Tag }> & {
  /** Set false for a plain max-width column without the 12-column grid. */
  grid?: boolean;
};

const { as: Tag = 'div', grid = true, class: className, ...rest } = Astro.props;
---

<div class="w-full px-5 md:px-10 lg:px-20">
  <Tag class:list={['mx-auto w-full max-w-[1680px]', grid && 'grid grid-cols-1 lg:grid-cols-12 lg:gap-x-6', className]} {...rest}>
    <slot />
  </Tag>
</div>
