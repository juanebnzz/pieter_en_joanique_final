---
/**
 * Site navigation. `overlay` sits transparently over the home hero and inherits
 * the hero section's mode (so its ink is the hero's ink); `bar` is the solid
 * version used on every other page and is a section of its own.
 */
import Section, { type Mode } from './Section.astro';
import NavLinks from './NavLinks.astro';

interface Props {
  variant?: 'bar' | 'overlay';
  mode?: Mode;
}
const { variant = 'bar', mode = 'linen' } = Astro.props;
const overlay = variant === 'overlay';
---

{
  overlay ? (
    <nav class="absolute top-0 left-0 right-0 z-20 bg-transparent">
      <NavLinks overlay />
    </nav>
  ) : (
    <Section as="nav" mode={mode} class="relative z-20 border-b border-rule">
      <NavLinks overlay={false} />
    </Section>
  )
}
