---
/**
 * The nav's inner row — shared by both Nav wrappers. Colour comes from the
 * enclosing section's mode.
 *
 * Below lg the links leave the bar: one row of logo · RSVP · menu, and the
 * menu opens a full-screen panel in the same mode (so on the home hero it is
 * olive, on inner pages linen). From lg the links sit inline as before.
 */
interface Props {
  overlay: boolean;
}
import { NAV_LINKS } from '../../lib/nav';

const { overlay } = Astro.props;
const current = Astro.url.pathname;
const rsvpFrame = overlay ? 'border-ink hover:bg-ink/15' : 'border-rule hover:border-ink';
---

<div class="mx-auto flex max-w-[1680px] items-center justify-between gap-x-4 px-5 py-3 md:px-10 lg:gap-x-6 lg:px-20 lg:py-4">
  <a href="/" class="flex min-h-[44px] items-center font-display italic font-medium text-[1.35rem] text-ink transition-opacity hover:opacity-65">P &amp; J</a>

  <div class="hidden items-center gap-x-8 lg:ml-auto lg:flex">
    {
      NAV_LINKS.map((l) => (
        <a
          href={l.href}
          aria-current={current === l.href ? 'page' : undefined}
          class:list={['nav-link text-ink underline-offset-[0.3em] hover:underline', current === l.href && 'underline']}
        >
          {l.label}
        </a>
      ))
    }
  </div>

  <div class="flex items-center gap-x-2 lg:gap-x-0">
    <a href="/rsvp" class:list={['nav-link justify-center border px-5 text-ink transition-colors', rsvpFrame]}>RSVP</a>
    <button
      type="button"
      data-menu-toggle
      aria-expanded="false"
      aria-controls="site-menu"
      class="-mr-2 flex h-[44px] w-[44px] flex-col items-center justify-center gap-[6px] text-ink lg:hidden"
    >
      <span class="sr-only">Menu</span>
      <span aria-hidden="true" class="block h-px w-[22px] bg-current"></span>
      <span aria-hidden="true" class="block h-px w-[22px] bg-current"></span>
    </button>
  </div>
</div>

<!-- MOBILE MENU · full screen, in the nav's own mode -->
<div id="site-menu" data-menu hidden class="fixed inset-0 z-50 flex flex-col bg-surface text-ink lg:hidden">
  <div class="flex items-center justify-between px-5 py-3 md:px-10">
    <a href="/" class="flex min-h-[44px] items-center font-display italic font-medium text-[1.35rem] text-ink">P &amp; J</a>
    <button type="button" data-menu-close class="-mr-2 flex h-[44px] w-[44px] items-center justify-center text-ink">
      <span class="sr-only">Close menu</span>
      <span aria-hidden="true" class="font-display text-[1.9rem] leading-none">×</span>
    </button>
  </div>

  <div class="flex flex-1 flex-col justify-center px-5 pb-10 md:px-10">
    <ul class="m-0 list-none border-t border-rule p-0">
      {
        [{ label: 'Home', href: '/' }, ...NAV_LINKS].map((l) => (
          <li class="border-b border-rule">
            <a
              href={l.href}
              aria-current={current === l.href ? 'page' : undefined}
              class:list={[
                'flex min-h-[64px] items-center py-4 font-display font-medium text-[1.75rem] text-ink',
                current === l.href && 'italic',
              ]}
            >
              {l.label}
            </a>
          </li>
        ))
      }
    </ul>
    <a
      href="/rsvp"
      class="mt-8 flex min-h-[56px] flex-col items-center justify-center bg-ink px-5 text-center text-surface transition-opacity hover:opacity-85"
    >
      <span class="font-body font-medium uppercase tracking-[0.18em] text-[0.95rem]">RSVP</span>
      <span class="font-body text-[0.72rem] tracking-[0.05em]">Kindly respond by 28 September 2026</span>
    </a>
  </div>

  <p class="px-5 pb-[calc(1.25rem+env(safe-area-inset-bottom,0px))] text-center font-body text-[0.75rem] tracking-[0.05em] text-ink md:px-10">
    14 November 2026 · Tshikwalo Game Lodge
  </p>
</div>

<script>
  // Mobile menu: toggle, close on Escape / link tap, lock scroll while open.
  const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const menu = document.querySelector<HTMLElement>('[data-menu]');
  const closeBtn = menu?.querySelector<HTMLButtonElement>('[data-menu-close]');
  if (toggle && menu && closeBtn) {
    const set = (open: boolean) => {
      menu.hidden = !open;
      toggle.setAttribute('aria-expanded', String(open));
      document.documentElement.style.overflow = open ? 'hidden' : '';
      (open ? closeBtn : toggle).focus();
    };
    toggle.addEventListener('click', () => set(!!menu.hidden));
    closeBtn.addEventListener('click', () => set(false));
    menu.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => set(false)));
    window.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !menu.hidden) set(false);
    });
    // If the viewport grows past lg while open, release the scroll lock.
    window.matchMedia('(min-width: 1024px)').addEventListener('change', (e) => {
      if (e.matches && !menu.hidden) set(false);
    });
  }
</script>
