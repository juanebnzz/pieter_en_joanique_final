---
/** The nav's inner row — shared by both Nav wrappers. Colour comes from the enclosing section's mode. */
interface Props {
  overlay: boolean;
}
import { NAV_LINKS } from '../../lib/nav';

const { overlay } = Astro.props;
const current = Astro.url.pathname;
---

<div class="mx-auto flex max-w-[1680px] flex-wrap items-center justify-between gap-x-6 gap-y-2 px-5 py-3 md:px-10 lg:flex-nowrap lg:px-20 lg:py-4">
  <a href="/" class="order-1 flex min-h-[44px] items-center font-display italic font-medium text-[1.35rem] text-ink transition-opacity hover:opacity-65"
    >P &amp; J</a
  >
  <div class="order-3 flex w-full flex-wrap items-center gap-x-5 gap-y-1 lg:order-2 lg:ml-auto lg:w-auto lg:justify-end lg:gap-x-8">
    {
      NAV_LINKS.map((l) => (
        <a
          href={l.href}
          aria-current={current === l.href ? 'page' : undefined}
          class:list={['nav-link text-ink underline-offset-[0.3em] hover:underline', current === l.href && 'underline']}
        >
          {l.label}
        </a>
      ))
    }
  </div>
  <a
    href="/rsvp"
    class:list={[
      'nav-link order-2 justify-center border px-5 text-ink transition-colors lg:order-3',
      overlay ? 'border-ink hover:bg-ink/15' : 'border-rule hover:border-ink',
    ]}
    >RSVP</a
  >
</div>
