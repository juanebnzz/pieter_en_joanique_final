---
/**
 * The nav's inner row — shared by both Nav wrappers. Colour comes from the
 * enclosing section's mode.
 *
 * Below lg the row wraps: logo · RSVP on the first line, the page tabs
 * centred on a second line beneath, set a touch smaller so all five fit on
 * a 360px phone — every page one tap away, no menu. From lg the
 * tabs sit inline between the logo and the RSVP frame.
 */
interface Props {
  overlay: boolean;
}
import { NAV_LINKS } from '../../lib/nav';

const { overlay } = Astro.props;
const current = Astro.url.pathname;
const rsvpFrame = overlay ? 'border-ink hover:bg-ink/15' : 'border-rule hover:border-ink';
---

<div class="mx-auto flex max-w-[1680px] flex-wrap items-center justify-between gap-x-6 gap-y-1 px-5 py-3 md:px-10 lg:flex-nowrap lg:gap-x-8 lg:px-20 lg:py-4">
  <a href="/" class="order-1 flex min-h-[44px] items-center font-display italic font-medium text-[1.35rem] text-ink transition-opacity hover:opacity-65">P &amp; J</a>

  <div class="order-3 flex w-full flex-wrap items-center justify-center gap-x-[clamp(0.6rem,3vw,1.25rem)] lg:order-2 lg:ml-auto lg:w-auto lg:justify-end lg:gap-x-8">
    {
      NAV_LINKS.map((l) => (
        <a href={l.href} aria-current={current === l.href ? 'page' : undefined} class="nav-link nav-tab text-ink max-lg:text-[0.68rem] max-lg:tracking-[0.09em]">
          {l.label}
        </a>
      ))
    }
  </div>

  <a href="/rsvp" class:list={['nav-link order-2 justify-center border px-5 text-ink transition-colors lg:order-3', rsvpFrame]}>RSVP</a>
</div>
