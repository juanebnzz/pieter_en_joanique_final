---
/**
 * Inner-page opener, in the voice of the invitation and the engagement shoot.
 *
 * A spread rule on top (kicker left, a small detail right — the running head
 * of a catalogue). The title is the home page's lockup: display lines in
 * Cormorant, closed by a script `flourish` ("A Few Moments / so far"). With a
 * photo, the text takes columns 1–6 and the photograph hangs in columns 8–12
 * as a matted print — a hairline frame around a hairline mat — with a wall
 * label underneath (italic caption, photographer credit). Without one, the
 * opener becomes the exhibition's entrance wall: everything centred, the
 * `detail` set as tracked caps between two short hairlines.
 *
 * From sm the two columns sit side by side on a 7/5 split; below sm the title
 * leads and the print follows, so a phone shows what the page is before the
 * image. `anchor` stretches the text column to the print's height and pins
 * the `foot` slot to its bottom edge, above a hairline.
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Section from './Section.astro';
import Grid from './Grid.astro';

interface Props {
  kicker: string;
  title: string;
  /** Script line that closes the title, set in Pinyon like "Married" on the home page. */
  flourish?: string;
  lead?: string;
  photo?: ImageMetadata;
  alt?: string;
  /** CSS aspect-ratio for the print; 4/5 for portraits, 3/2 for landscapes. */
  ratio?: string;
  /** object-position, when the subject sits off centre. */
  position?: string;
  /** Wall label under the print — the photograph's title, set in italics. */
  caption?: string;
  /** Right-hand side of the wall label. */
  credit?: string;
  /**
   * Short label / value rows set at the foot of the text column, above the
   * `foot` line — a programme, an index of chapters, the dates that matter.
   * They give the column a bottom edge to meet the print's, so a tall
   * portrait never leaves the left side empty. With an `href` (an in-page
   * anchor, say "#chapter-3") the row becomes a link to that section.
   */
  facts?: { label: string; value: string; href?: string }[];
  /** Pin the `foot` slot to the print's bottom edge (text column spans its full height). */
  anchor?: boolean;
  /** Small right-aligned detail on the spread rule; the hairline line when there is no photo. */
  detail?: string;
}
const {
  kicker,
  title,
  flourish,
  lead,
  photo,
  alt = '',
  ratio = '4/5',
  position = '50% 40%',
  caption,
  credit = 'Photography by Bitiah',
  facts = [],
  anchor = false,
  detail,
} = Astro.props;
// A "\n" in the title sets a deliberate line break, so a date never wraps by accident.
const titleLines = title.split('\n');
const hairline = 'border-color:color-mix(in srgb, var(--color-ink) 45%, transparent);';
---

<Section mode="linen" class="pt-8 pb-10 md:pt-10 md:pb-14 lg:pt-14 lg:pb-16">
  <Grid class="gap-y-8 sm:grid-cols-12 sm:gap-x-6 lg:gap-y-10">
    <!-- Spread rule: the running head. -->
    <div class="flex items-baseline justify-between gap-x-6 border-b border-rule pb-4 sm:col-span-12">
      <span class="eyebrow">{kicker}</span>
      {photo && detail && <span class="eyebrow hidden text-right sm:block">{detail}</span>}
    </div>

    {
      photo ? (
        <>
          <div
            class:list={[
              'sm:col-span-7 lg:col-span-6',
              anchor ? 'sm:flex sm:flex-col sm:justify-between sm:self-stretch' : 'sm:self-center sm:pt-4 lg:pt-12',
            ]}
          >
            <div>
              <h1 class="flex flex-col items-start font-display font-medium text-display text-ink">
                {titleLines.map((l) => (
                  <span class="block">{l}</span>
                ))}
                {flourish && (
                  <span class="-mt-[0.04em] ml-[0.35em] block font-script font-normal leading-none text-[clamp(2.3rem,1.7rem+2.4vw,3.6rem)]">
                    {flourish}
                  </span>
                )}
              </h1>
              {lead && <p class="mt-6 max-w-[44ch] font-display text-lead text-ink lg:mt-8">{lead}</p>}
              <slot />
            </div>
            {anchor && (
              <div class="mt-8 sm:mt-10">
                {facts.length > 0 && (
                  <dl class="m-0 mb-3">
                    {facts.map((f) => (
                      <div
                        class:list={[
                          'flex items-baseline gap-x-6 border-t border-rule py-3',
                          f.href && 'group relative transition-colors duration-300 hover:text-accent',
                        ]}
                      >
                        <dt class="eyebrow w-[7.5rem] flex-none">{f.label}</dt>
                        <dd class="m-0 font-display text-[1.1rem] leading-snug text-ink group-hover:text-accent md:text-[1.2rem]">
                          {f.href ? (
                            <a href={f.href} class="after:absolute after:inset-0 focus-visible:text-accent">
                              {f.value}
                            </a>
                          ) : (
                            f.value
                          )}
                        </dd>
                      </div>
                    ))}
                  </dl>
                )}
                <div class="border-t border-rule pt-5">
                  <slot name="foot" />
                </div>
              </div>
            )}
          </div>

          <!-- The print: hairline frame, linen mat, hairline around the photograph, wall label beneath. -->
          <figure class="m-0 sm:col-start-8 sm:col-span-5">
            <div class="border p-3 md:p-4" style={hairline}>
              <div class="relative overflow-hidden border border-rule" style={`aspect-ratio:${ratio};`}>
                <Image
                  src={photo}
                  alt={alt}
                  widths={[640, 1024, 1600]}
                  sizes="(min-width: 1024px) 42vw, 100vw"
                  loading="eager"
                  class="absolute inset-0 h-full w-full object-cover"
                  style={`object-position:${position};`}
                />
              </div>
            </div>
            {(caption || credit) && (
              <figcaption class="mt-3 flex items-baseline justify-between gap-x-4 md:mt-4">
                {caption && <span class="font-display italic text-[1.05rem] leading-snug text-ink md:text-[1.15rem]">{caption}</span>}
                {credit && <span class="eyebrow flex-none text-[0.66rem] tracking-[0.18em]">{credit}</span>}
              </figcaption>
            )}
          </figure>
        </>
      ) : (
        <div class="pt-4 text-center sm:col-span-12 md:pt-6 lg:col-start-3 lg:col-span-8 lg:pt-8">
          <h1 class="flex flex-col items-center font-display font-medium text-display text-ink">
            {titleLines.map((l) => (
              <span class="block">{l}</span>
            ))}
            {flourish && (
              <span class="-mt-[0.04em] block font-script font-normal leading-none text-[clamp(2.3rem,1.7rem+2.4vw,3.6rem)]">{flourish}</span>
            )}
          </h1>
          {lead && <p class="mx-auto mt-6 max-w-[48ch] font-display text-lead text-ink lg:mt-8">{lead}</p>}
          <slot />
          {detail && (
            <p class="mt-8 flex items-center justify-center gap-x-3 font-body font-medium uppercase tracking-[0.16em] [text-indent:0.16em] text-ink text-[0.72rem] md:mt-10 md:gap-x-4 md:text-[0.8rem]">
              <span aria-hidden="true" class="h-px w-6 flex-none bg-ink md:w-12" />
              {detail}
              <span aria-hidden="true" class="h-px w-6 flex-none bg-ink md:w-12" />
            </p>
          )}
        </div>
      )
    }
  </Grid>
</Section>
