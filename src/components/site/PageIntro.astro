---
/**
 * Inner-page opener. Kicker, display title and an optional lead in columns
 * 1–6; an optional photograph in columns 8–12 (archetype B: the text block is
 * offset below the image top). From sm the two sit side by side on a 7/5
 * split; below sm the title leads and the photo follows it, so a phone shows
 * what the page is before the image.
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Section from './Section.astro';
import Grid from './Grid.astro';

interface Props {
  kicker: string;
  title: string;
  lead?: string;
  photo?: ImageMetadata;
  alt?: string;
  /** CSS aspect-ratio for the photo frame; 4/5 for portraits, 3/2 for landscapes. */
  ratio?: string;
  /** object-position, when the subject sits off centre. */
  position?: string;
  /** Push the text block below the image top and centre it (default). Set false to top-align the column with the photo instead. */
  offset?: boolean;
  /**
   * Anchor the `foot` slot to the photo's bottom edge, above a hairline, so the
   * text column spans the photo's full height (headline top-left, caption
   * bottom-left). Implies offset={false}. Use it when the page has a closing
   * line for the intro — a ceremony time, a reply-by date, an opening quote.
   */
  anchor?: boolean;
  /** Small right-aligned detail sitting over the photo on the spread rule (anchor only). */
  detail?: string;
}
const { kicker, title, lead, photo, alt = '', ratio = '4/5', position = '50% 40%', anchor = false, detail } = Astro.props;
const offset = anchor ? false : (Astro.props.offset ?? true);
// A "\n" in the title sets a deliberate line break, so a date never wraps by accident.
const titleLines = title.split('\n');
---

<Section mode="linen" class="pt-8 pb-10 md:pt-10 md:pb-14 lg:pt-14 lg:pb-16">
  <Grid class="gap-y-8 sm:grid-cols-12 sm:gap-x-6 lg:gap-y-10">
    {
      anchor && photo && (
        <div class="flex items-baseline justify-between gap-x-6 border-b border-rule pb-4 sm:col-span-12">
          <span class="eyebrow">{kicker}</span>
          {detail && <span class="eyebrow hidden text-right sm:block">{detail}</span>}
        </div>
      )
    }
    <div
      class:list={[
        photo ? 'sm:col-span-7 lg:col-span-6' : 'sm:col-span-10 lg:col-span-8',
        photo && (anchor ? 'sm:flex sm:flex-col sm:justify-between sm:self-stretch' : offset ? 'sm:self-center sm:pt-6 lg:pt-16' : 'sm:self-start sm:pt-2'),
      ]}
    >
      <div>
        {!(anchor && photo) && <div class="eyebrow mb-6">{kicker}</div>}
        <h1 class="font-display font-medium text-display text-ink">
          {titleLines.length > 1 ? titleLines.map((l) => <span class="block">{l}</span>) : title}
        </h1>
        {lead && <p class="mt-6 max-w-[44ch] font-display text-lead text-ink lg:mt-8">{lead}</p>}
        <slot />
      </div>
      {
        anchor && (
          <div class="mt-8 border-t border-rule pt-5 sm:mt-10">
            <slot name="foot" />
          </div>
        )
      }
    </div>
    {
      photo && (
        <div class="relative overflow-hidden sm:col-start-8 sm:col-span-5" style={`aspect-ratio:${ratio};`}>
          <Image
            src={photo}
            alt={alt}
            widths={[640, 1024, 1600]}
            sizes="(min-width: 1024px) 42vw, 100vw"
            loading="eager"
            class="absolute inset-0 h-full w-full object-cover"
            style={`object-position:${position};`}
          />
        </div>
      )
    }
  </Grid>
</Section>
