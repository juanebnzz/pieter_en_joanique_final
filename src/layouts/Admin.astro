---
/**
 * Admin shell. Installable as a PWA scoped to /admin/ — the manifest and
 * service worker live in public/admin/ so they're served as static files.
 */
import '../styles/global.css';

interface Props {
  title?: string;
}
const { title = 'Wedding admin' } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{title}</title>

    <link rel="manifest" href="/admin/manifest.webmanifest" />
    <meta name="theme-color" content="#1f1d1b" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="P&J Admin" />
    <link rel="apple-touch-icon" href="/admin/icon-192.png" />
    <link rel="icon" type="image/png" href="/admin/icon-192.png" />
  </head>
  <body class="min-h-dvh bg-neutral-50 text-neutral-900 antialiased">
    <slot />
    <script>
      if ('serviceWorker' in navigator) {
        window.addEventListener('load', () => {
          navigator.serviceWorker.register('/admin/sw.js', { scope: '/admin/' }).catch(() => {});
        });
      }
    </script>
  </body>
</html>
