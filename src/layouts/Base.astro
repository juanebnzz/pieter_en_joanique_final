---
import '../styles/global.css';
import { palette } from '../lib/palette';

interface Props {
  title: string;
  description?: string;
  noindex?: boolean;
}

const {
  title,
  description = 'Pieter & Joanique are getting married on Saturday, 14 November 2026 at Tshikwalo Game Lodge, Dinokeng Game Reserve.',
  noindex = false,
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <meta name="theme-color" content={palette.linen} />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <script is:inline>
      // Scroll-reveal fails open: [data-reveal] content is visible by default and
      // only starts hidden once this class proves JS is running (see global.css).
      document.documentElement.classList.add('js-enabled');
      // Hero variations for client review: ?hero=b switches the home hero; ?hero=a (or
      // no param) is the default. Remembered for the tab so the choice survives navigation.
      try {
        var heroParam = new URLSearchParams(location.search).get('hero');
        if (heroParam) sessionStorage.setItem('hero', heroParam);
        var heroVariant = heroParam || sessionStorage.getItem('hero');
        if (heroVariant && heroVariant !== 'a') document.documentElement.dataset.hero = heroVariant;
      } catch (e) {}
    </script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Bodoni+Moda:opsz,wght@6..96,400..500&family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;1,400;1,500&family=Jost:wght@400;500;600&family=Pinyon+Script&display=swap"
      rel="stylesheet"
    />
    <slot name="head" />
  </head>
  <body class="min-h-dvh bg-surface text-ink font-body">
    <!-- overflow-x-clip, not -hidden: hidden would make .site a scroll container and break the sticky nav -->
    <div class="site w-full overflow-x-clip">
      <slot />
    </div>
    <script>
      // Scroll reveal — mirrors the design's attachReveal(): visible once the
      // element's top crosses 92% of the viewport.
      const els = document.querySelectorAll<HTMLElement>('[data-reveal]');
      if ('IntersectionObserver' in window) {
        const io = new IntersectionObserver(
          (entries) => {
            for (const e of entries) {
              if (e.isIntersecting) {
                e.target.classList.add('is-visible');
                io.unobserve(e.target);
              }
            }
          },
          { rootMargin: '0px 0px -8% 0px', threshold: 0 },
        );
        els.forEach((el) => io.observe(el));
      } else {
        els.forEach((el) => el.classList.add('is-visible'));
      }
    </script>
  </body>
</html>
