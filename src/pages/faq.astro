---
import Base from '../layouts/Base.astro';
import Section from '../components/site/Section.astro';
import Grid from '../components/site/Grid.astro';
import PageIntro from '../components/site/PageIntro.astro';
import Nav from '../components/site/Nav.astro';
import Footer from '../components/site/Footer.astro';

export const prerender = true;

const faqs = [
  {
    q: 'Can I bring a plus-one?',
    a: 'We have carefully planned our guest list, but if you would like to bring someone, please reach out to us directly. We would be happy to chat about it.',
  },
  { q: 'Are children welcome?', a: 'Yes. Children under 2 stay free, and children aged 2 to 12 are R270 per child per night.' },
  {
    q: 'Is there a conservation fee?',
    a: 'Yes. Dinokeng Game Reserve charges a conservation fee of R100 per guest, which you pay at the reserve gate when you arrive. It is separate from your accommodation payment and does not go to Pieter and Joanique.',
  },
  {
    q: 'Is Saturday night compulsory?',
    a: 'Yes, up to full capacity, as we are booking out the entire venue with accommodation on site. If you have other arrangements, please contact us directly.',
  },
  { q: 'What time is check-in and check-out?', a: 'Check-in from 14:00 on Friday. Check-out at 10:00 on Sunday.' },
  {
    q: 'How do I pay?',
    a: 'Accommodation is paid directly to Pieter and Joanique by EFT, by 16 October 2026. The banking details are on The Weekend page, beside the prices, and on the RSVP page. Use your initials and surname as the reference.',
  },
  {
    q: 'Can I bring my own food or drinks?',
    a: 'No outside food or drinks are permitted. A cash bar and the on-site restaurant are available all weekend.',
  },
  { q: 'What is the road like?', a: 'The venue is accessed by a dirt road that is suitable for all vehicles. Secure parking is provided.' },
  { q: 'Who do I contact with questions?', a: 'Pieter Kruger — 083 798 0144 — pieterkruger2911@gmail.com' },
];
---

<Base title="FAQ — Pieter & Joanique">
  <Nav />

  <PageIntro kicker="FAQ" title="Frequently Asked Questions" />

  <Section mode="linen" class="pb-20 lg:pb-28">
    <Grid>
      <div class="border-t border-rule lg:col-start-3 lg:col-span-7">
        {
          faqs.map((f) => (
            <div data-reveal class="max-w-[64ch] border-b border-rule py-6">
              <p class="mb-2 font-display font-medium text-title text-ink">{f.q}</p>
              <p class="font-body text-body text-ink">{f.a}</p>
            </div>
          ))
        }
      </div>
    </Grid>
  </Section>

  <Footer />
</Base>
