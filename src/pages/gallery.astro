---
import { Image, getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Base from '../layouts/Base.astro';
import Nav from '../components/site/Nav.astro';
import Footer from '../components/site/Footer.astro';

export const prerender = true;

// All 46 engagement highlights, in shoot order (g-01 … g-46). Drop a file into
// src/assets/photos/gallery/ and it appears here automatically.
const modules = import.meta.glob<{ default: ImageMetadata }>('../assets/photos/gallery/*.jpg', { eager: true });
const photos = Object.keys(modules)
  .sort()
  .map((k) => modules[k].default);

const full = await Promise.all(photos.map((p) => getImage({ src: p, width: 1800, format: 'webp' })));
const fullSrcs = full.map((f) => f.src);

// Layout rhythm: landscape frames become full-width bands; portraits are
// grouped in a repeating pair / single / trio / pair cadence.
type Block = { kind: 'band'; i: number } | { kind: 'row'; i: number[] };
const cadence = [2, 1, 3, 2];
const blocks: Block[] = [];
let step = 0;
let pending: number[] = [];
const flush = () => {
  if (pending.length) blocks.push({ kind: 'row', i: pending });
  pending = [];
};
photos.forEach((p, idx) => {
  if (p.width > p.height) {
    flush();
    blocks.push({ kind: 'band', i: idx });
    return;
  }
  pending.push(idx);
  if (pending.length === cadence[step % cadence.length]) {
    flush();
    step++;
  }
});
flush();

const img = 'h-full w-full object-cover transition-transform duration-500 hover:scale-[1.03]';
---

<Base title="Gallery — Pieter & Joanique">
  <Nav />

  <div class="flex flex-col gap-[2px] bg-brand-rule py-[5cqw]">
    {
      blocks.map((b) =>
        b.kind === 'band' ? (
          <div data-reveal class="h-[clamp(320px,62cqw,720px)] w-full cursor-pointer overflow-hidden bg-brand-bg">
            <button type="button" data-lightbox={b.i} class="block h-full w-full" aria-label="Open photo">
              <Image src={photos[b.i]} alt="Pieter and Joanique" widths={[800, 1400, 2000]} sizes="100vw" class={img} />
            </button>
          </div>
        ) : (
          <div data-reveal class="flex flex-wrap gap-[2px]">
            {b.i.map((idx) => (
              <div
                class:list={[
                  'cursor-pointer overflow-hidden bg-brand-bg',
                  b.i.length === 1
                    ? 'h-[clamp(420px,110cqw,900px)] w-full'
                    : b.i.length === 2
                      ? 'h-[clamp(320px,70cqw,720px)] min-w-[220px] flex-[1_1_260px]'
                      : 'h-[clamp(280px,50cqw,560px)] min-w-[200px] flex-[1_1_200px]',
                ]}
              >
                <button type="button" data-lightbox={idx} class="block h-full w-full" aria-label="Open photo">
                  <Image
                    src={photos[idx]}
                    alt="Pieter and Joanique"
                    widths={[640, 1024, 1600]}
                    sizes={b.i.length === 1 ? '100vw' : b.i.length === 2 ? '(min-width: 700px) 50vw, 100vw' : '(min-width: 700px) 33vw, 100vw'}
                    class={img}
                  />
                </button>
              </div>
            ))}
          </div>
        ),
      )
    }
  </div>

  <div class="px-[6cqw] py-[5cqw] text-center">
    <p class="font-body text-[0.8rem] tracking-[0.04em] text-brand-muted">Photography by Noeline le Roux, By Bitiah</p>
  </div>

  <Footer />

  <!-- LIGHTBOX -->
  <div
    id="lightbox"
    hidden
    class="fixed inset-0 z-[999] flex items-center justify-center bg-brand-ink"
    role="dialog"
    aria-modal="true"
    aria-label="Photo"
    data-srcs={JSON.stringify(fullSrcs)}
  >
    <img id="lightbox-img" alt="" class="pointer-events-none max-h-[82%] max-w-[92%] object-contain" />
    <div id="lightbox-counter" class="pointer-events-none absolute bottom-[2.2em] left-0 right-0 text-center font-body text-[0.85rem] tracking-[0.08em] text-brand-bg"></div>
  </div>

  <script>
    const box = document.getElementById('lightbox') as HTMLDivElement;
    const img = document.getElementById('lightbox-img') as HTMLImageElement;
    const counter = document.getElementById('lightbox-counter') as HTMLDivElement;
    const srcs: string[] = JSON.parse(box.dataset.srcs ?? '[]');
    const n = srcs.length;
    let idx = -1;
    let startX = 0;

    function preload(i: number) {
      new window.Image().src = srcs[(i + n) % n];
    }
    function show(i: number) {
      idx = (i + n) % n;
      img.src = srcs[idx];
      counter.textContent = `${String(idx + 1).padStart(2, '0')} / ${String(n).padStart(2, '0')}`;
      box.hidden = false;
      document.body.style.overflow = 'hidden';
      preload(idx + 1);
      preload(idx - 1);
    }
    function close() {
      box.hidden = true;
      document.body.style.overflow = '';
    }

    document.querySelectorAll<HTMLElement>('[data-lightbox]').forEach((el) => {
      el.addEventListener('click', () => show(Number(el.dataset.lightbox)));
    });
    box.addEventListener('click', close);
    box.addEventListener('touchstart', (e) => { startX = e.touches[0].clientX; }, { passive: true });
    box.addEventListener('touchend', (e) => {
      e.preventDefault();
      const dx = e.changedTouches[0].clientX - startX;
      if (Math.abs(dx) > 40) show(dx < 0 ? idx + 1 : idx - 1);
      else close();
    });
    window.addEventListener('keydown', (e) => {
      if (box.hidden) return;
      if (e.key === 'Escape') close();
      if (e.key === 'ArrowRight') show(idx + 1);
      if (e.key === 'ArrowLeft') show(idx - 1);
    });
  </script>
</Base>
