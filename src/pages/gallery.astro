---
import { Image, getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Base from '../layouts/Base.astro';
import Section from '../components/site/Section.astro';
import Nav from '../components/site/Nav.astro';
import Footer from '../components/site/Footer.astro';

export const prerender = true;

// Ten frames from the engagement shoot at the gallery, in a loose narrative
// order: arriving, a first hand, the two of them, each alone, and the dip.
// Each carries its own alt text; g-NN numbering follows the photographer's export.
import g05 from '../assets/photos/gallery/g-05.jpg';
import g30 from '../assets/photos/gallery/g-30.jpg';
import g33 from '../assets/photos/gallery/g-33.jpg';
import g15 from '../assets/photos/gallery/g-15.jpg';
import g19 from '../assets/photos/gallery/g-19.jpg';
import g28 from '../assets/photos/gallery/g-28.jpg';
import g42 from '../assets/photos/gallery/g-42.jpg';
import g40 from '../assets/photos/gallery/g-40.jpg';
import g37 from '../assets/photos/gallery/g-37.jpg';
import g46 from '../assets/photos/gallery/g-46.jpg';

const gallery: { src: ImageMetadata; alt: string }[] = [
  { src: g05, alt: 'Pieter and Joanique laughing as they walk hand in hand past a wall of bright paintings in a white gallery.' },
  { src: g30, alt: 'Pieter and Joanique holding hands in a doorway, framed by white walls with a parquet floor beneath them.' },
  { src: g33, alt: 'Black and white close-up of Pieter and Joanique\'s hands reaching for each other, her engagement ring catching the light.' },
  { src: g15, alt: 'Pieter and Joanique smiling at the camera, her hand on his chest, in front of framed artworks on a green gallery wall.' },
  { src: g19, alt: 'Black and white photograph of Pieter and Joanique in a close embrace, foreheads almost touching, beside framed prints.' },
  { src: g28, alt: 'Joanique glancing back over her shoulder with a smile, in a white dress against a teal gallery wall lined with framed drawings.' },
  { src: g42, alt: 'Pieter grinning, hands in his pockets, in a black shirt against a teal gallery wall lined with framed drawings.' },
  { src: g40, alt: 'Pieter and Joanique sitting close together in a wooden chair, watching a vintage television in a dim exhibition room.' },
  { src: g37, alt: 'Black and white close-up of Pieter and Joanique nose to nose, her hand resting on his cheek.' },
  { src: g46, alt: 'Pieter dipping Joanique in a dance in front of a teal gallery wall, her heel kicked up behind her.' },
];
const photos = gallery.map((g) => g.src);

const full = await Promise.all(photos.map((p) => getImage({ src: p, width: 2400, format: 'webp', quality: 90 })));
const fullSrcs = full.map((f) => f.src);

// Layout rhythm: landscape frames become full-width bands; portraits are
// grouped in a repeating pair / single / trio / pair cadence.
type Block = { kind: 'band'; i: number } | { kind: 'row'; i: number[] };
const cadence = [2, 1, 3, 2];
const blocks: Block[] = [];
let step = 0;
let pending: number[] = [];
const flush = () => {
  if (pending.length) blocks.push({ kind: 'row', i: pending });
  pending = [];
};
photos.forEach((p, idx) => {
  if (p.width > p.height) {
    flush();
    blocks.push({ kind: 'band', i: idx });
    return;
  }
  pending.push(idx);
  if (pending.length === cadence[step % cadence.length]) {
    flush();
    step++;
  }
});
flush();

const img = 'h-full w-full object-cover transition-transform duration-500 hover:scale-[1.03]';
---

<Base title="Gallery — Pieter & Joanique">
  <Nav />

  <!-- HEADING · burlap -->
  <Section mode="burlap" class="px-[6cqw] py-[6cqw]">
    <div class="mx-auto max-w-[680px]">
      <h1 class="font-display font-medium text-ink text-[clamp(2.2rem,8cqw,3rem)]">Gallery</h1>
      <p class="mt-[0.6em] font-body text-[0.95rem] text-ink">A few moments from our engagement shoot.</p>
    </div>
  </Section>

  <!-- GRID · espresso (engagement imagery); the section surface shows through the 2px gutters -->
  <Section mode="espresso" class="flex flex-col gap-[2px] py-[5cqw]">
    {
      blocks.map((b) =>
        b.kind === 'band' ? (
          <div data-reveal class="h-[clamp(320px,62cqw,720px)] w-full cursor-pointer overflow-hidden bg-surface">
            <button type="button" data-lightbox={b.i} class="block h-full w-full" aria-label={`Open photo ${b.i + 1} of ${photos.length}`}>
              <Image src={photos[b.i]} alt={gallery[b.i].alt} widths={[800, 1400, 2400]} sizes="100vw" quality={90} class={img} />
            </button>
          </div>
        ) : (
          <div data-reveal class="flex flex-wrap gap-[2px]">
            {b.i.map((idx) => (
              <div
                class:list={[
                  'cursor-pointer overflow-hidden bg-surface',
                  b.i.length === 1
                    ? 'h-[clamp(420px,110cqw,900px)] w-full'
                    : b.i.length === 2
                      ? 'h-[clamp(320px,70cqw,720px)] min-w-[220px] flex-[1_1_260px]'
                      : 'h-[clamp(280px,50cqw,560px)] min-w-[200px] flex-[1_1_200px]',
                ]}
              >
                <button type="button" data-lightbox={idx} class="block h-full w-full" aria-label={`Open photo ${idx + 1} of ${photos.length}`}>
                  <Image
                    src={photos[idx]}
                    alt={gallery[idx].alt}
                    widths={[640, 1024, 1600, 2400]}
                    quality={90}
                    sizes={b.i.length === 1 ? '100vw' : b.i.length === 2 ? '(min-width: 700px) 50vw, 100vw' : '(min-width: 700px) 33vw, 100vw'}
                    class={img}
                  />
                </button>
              </div>
            ))}
          </div>
        ),
      )
    }
  </Section>

  <!-- CREDIT · linen -->
  <Section mode="linen" class="px-[6cqw] py-[5cqw] text-center">
    <p class="font-body text-[0.8rem] tracking-[0.04em] text-ink">Photography by Bitiah</p>
  </Section>

  <Footer />

  <!-- LIGHTBOX · espresso (out of flow) -->
  <Section
    as="div"
    mode="espresso"
    id="lightbox"
    hidden
    class="fixed inset-0 z-[999] flex items-center justify-center"
    role="dialog"
    aria-modal="true"
    aria-label="Photo"
    data-srcs={JSON.stringify(fullSrcs)}
    data-alts={JSON.stringify(gallery.map((g) => g.alt))}
  >
    <img id="lightbox-img" alt="" class="pointer-events-none max-h-[82%] max-w-[92%] object-contain" />
    <div id="lightbox-counter" class="pointer-events-none absolute bottom-[2.2em] left-0 right-0 text-center font-body text-[0.85rem] tracking-[0.08em] text-ink"></div>
  </Section>

  <script>
    const box = document.getElementById('lightbox') as HTMLDivElement;
    const img = document.getElementById('lightbox-img') as HTMLImageElement;
    const counter = document.getElementById('lightbox-counter') as HTMLDivElement;
    const srcs: string[] = JSON.parse(box.dataset.srcs ?? '[]');
    const alts: string[] = JSON.parse(box.dataset.alts ?? '[]');
    const n = srcs.length;
    let idx = -1;
    let startX = 0;

    function preload(i: number) {
      new window.Image().src = srcs[(i + n) % n];
    }
    function show(i: number) {
      idx = (i + n) % n;
      img.src = srcs[idx];
      img.alt = alts[idx] ?? '';
      counter.textContent = `${String(idx + 1).padStart(2, '0')} / ${String(n).padStart(2, '0')}`;
      box.hidden = false;
      document.body.style.overflow = 'hidden';
      preload(idx + 1);
      preload(idx - 1);
    }
    function close() {
      box.hidden = true;
      document.body.style.overflow = '';
    }

    document.querySelectorAll<HTMLElement>('[data-lightbox]').forEach((el) => {
      el.addEventListener('click', () => show(Number(el.dataset.lightbox)));
    });
    box.addEventListener('click', close);
    box.addEventListener('touchstart', (e) => { startX = e.touches[0].clientX; }, { passive: true });
    box.addEventListener('touchend', (e) => {
      e.preventDefault();
      const dx = e.changedTouches[0].clientX - startX;
      if (Math.abs(dx) > 40) show(dx < 0 ? idx + 1 : idx - 1);
      else close();
    });
    window.addEventListener('keydown', (e) => {
      if (box.hidden) return;
      if (e.key === 'Escape') close();
      if (e.key === 'ArrowRight') show(idx + 1);
      if (e.key === 'ArrowLeft') show(idx - 1);
    });
  </script>
</Base>
