---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Section from '../components/site/Section.astro';
import Grid from '../components/site/Grid.astro';
import Nav from '../components/site/Nav.astro';
import Footer from '../components/site/Footer.astro';
import Interlude from '../components/site/Interlude.astro';
import hero from '../assets/photos/gallery/g-44.jpg';
import storyPhoto from '../assets/photos/gallery/g-39.jpg';
import moment1 from '../assets/photos/gallery/g-45.jpg';
import moment2 from '../assets/photos/gallery/g-38.jpg';
import moment3 from '../assets/photos/gallery/g-17.jpg';
import venueDrawing from '../assets/illustrations/ceremony-venue.png';

export const prerender = true;

// One ground (linen), hairline rules between sections, and a mode change used
// as an event: the hero and footer are olive, burlap once for the Our Story teaser.

// Hero overlays resolve toward the section's own surface colour.
const heroScrim =
  'background:linear-gradient(to bottom, color-mix(in srgb, var(--color-surface) 0%, transparent) 35%, color-mix(in srgb, var(--color-surface) 55%, transparent) 70%, color-mix(in srgb, var(--color-surface) 85%, transparent) 100%);';
const navScrim =
  'background:linear-gradient(to bottom, color-mix(in srgb, var(--color-surface) 45%, transparent) 0%, color-mix(in srgb, var(--color-surface) 0%, transparent) 100%);';
const orientation = [
  { label: 'The Weekend', detail: 'Friday 13 to Sunday 15 November 2026' },
  { label: 'The Place', detail: 'Tshikwalo Game Lodge, Dinokeng Game Reserve' },
  { label: 'RSVP by', detail: '28 September 2026' },
];

const storyAlt = 'Black and white photograph of Pieter and Joanique standing close, looking at a single framed print on a wide white gallery wall.';

const moments = [
  { src: moment1, alt: 'Pieter dipping Joanique in a dance in front of a teal gallery wall, her heel kicked up behind her.' },
  { src: moment2, alt: 'Black and white photograph of Pieter from behind, Joanique hidden in his arms, her hand at the back of his neck, a framed print ahead of them.' },
  { src: moment3, alt: "Pieter lifting Joanique's hand as if to spin her, both laughing, in the green gallery." },
];
---

<Base title="Pieter & Joanique · 14 November 2026">
  <!-- Sticky overlay nav: a sibling of the hero, not a child, because the hero clips overflow -->
  <Nav variant="overlay" mode="olive" />

  <!-- HERO · olive (g-44, the monochrome kiss on the gallery bench), full bleed under the overlay nav and
       fading into the olive ground at the foot — kept exactly as the couple want it. Names on one line in the
       launch face; the date keeps its hairline invitation treatment. -->
  <Section mode="olive" class="relative m-0 h-[84svh] min-h-[600px] w-full overflow-hidden">
    <Image
      src={hero}
      alt="Black and white photograph of Pieter and Joanique seated on a gallery bench, noses touching, framed prints behind them."
      widths={[640, 1024, 1600, 2400]}
      sizes="100vw"
      quality={85}
      loading="eager"
      fetchpriority="high"
      class="absolute inset-0 block h-full w-full object-cover"
    />
    <div class="pointer-events-none absolute inset-0" style={heroScrim}></div>
    <div class="pointer-events-none absolute left-0 right-0 top-0 h-[26cqw] min-h-[120px]" style={navScrim}></div>
    <div class="pointer-events-none absolute bottom-0 left-0 right-0 px-5 pb-7 pt-[8cqw] text-center md:px-[6cqw] md:pb-[6cqw]">
      <h1 class="mb-5 font-display font-medium uppercase leading-[1.05] tracking-[0.02em] [text-indent:0.02em] text-ink text-[clamp(2.2rem,9cqw,5rem)] md:mb-7">
        Pieter &amp; Joanique
      </h1>
      <!-- Date as an invitation line: tracked caps between two short hairlines. -->
      <p class="mb-3 flex items-center justify-center gap-x-3 whitespace-nowrap font-body font-medium uppercase tracking-[0.14em] [text-indent:0.14em] text-ink text-[clamp(0.75rem,2cqw,0.95rem)] md:mb-4 md:gap-x-4 md:tracking-[0.18em] md:[text-indent:0.18em]">
        <span aria-hidden="true" class="h-px w-6 flex-none bg-ink md:w-12"></span>
        Saturday, 14 November 2026
        <span aria-hidden="true" class="h-px w-6 flex-none bg-ink md:w-12"></span>
      </p>
      <p class="mb-7 font-body tracking-[0.04em] text-ink text-[clamp(0.95rem,2.2cqw,1.15rem)] md:mb-9 md:whitespace-nowrap">
        Tshikwalo Game Lodge,<br class="md:hidden" /> Dinokeng Game Reserve
      </p>
      <!-- One primary CTA. A filled slab on phones (no hover there); from md a hairline frame that fills on hover. -->
      <a
        href="/rsvp"
        class="pointer-events-auto mx-auto flex min-h-[64px] w-full max-w-[520px] flex-col items-center justify-center gap-[0.15em] border border-ink bg-ink px-[1.5em] py-[0.9em] text-surface transition-colors md:max-w-[320px] md:bg-transparent md:text-ink md:hover:bg-ink md:hover:text-surface"
      >
        <span class="font-body font-medium uppercase tracking-[0.18em] [text-indent:0.18em] text-[clamp(1rem,2.6cqw,1.15rem)]">RSVP</span>
        <span class="font-body text-[0.78rem] tracking-[0.05em]">Kindly respond by 28 September 2026</span>
      </a>
    </div>
  </Section>

  <!-- INVITATION + A NOTE FROM US · linen, centred in columns 4–9, with generous space before the orientation strip.
       The lockup is two lines read as one: "We're Getting" is Cormorant caps, the same voice as the hero names, and the
       script "Married" is set ~1.6× that line (Pinyon's x-height is small) and pulled upward with a negative em margin
       so it scales with the clamp. -->
  <Section mode="linen" data-reveal class="pt-12 pb-16 md:pt-20 md:pb-32 lg:pt-24 lg:pb-40">
    <Grid class="border-t border-rule pt-12 md:pt-14 lg:pt-20">
      <div class="text-center lg:col-start-4 lg:col-span-6">
        <div class="eyebrow mb-8">Wedding Invitation</div>
        <p class="mb-10 flex flex-col items-center text-ink md:mb-12">
          <span class="font-display font-medium uppercase leading-none tracking-[0.12em] [text-indent:0.12em] text-[clamp(1.75rem,6.5cqw,3rem)]">We're Getting</span>
          <span class="-mt-[0.16em] font-script leading-none text-[clamp(2.8rem,10.4cqw,4.8rem)]">Married</span>
        </p>
        <p class="mx-auto mb-8 max-w-[52ch] font-display text-lead text-ink">
          We are truly grateful to have you celebrate our special day with us. Each of you was invited with care, and we
          look forward to seeing you all. We cannot wait to make lasting memories with you.
        </p>
        <p class="font-display italic text-title text-ink">With love, Pieter &amp; Joanique</p>
        <!-- The ceremony pavilion from The Weekend, as a small closing flourish. Multiply lets the linen show through. -->
        <Image
          src={venueDrawing}
          alt=""
          aria-hidden="true"
          widths={[240, 480]}
          sizes="140px"
          class="mx-auto mt-10 h-auto w-[120px] opacity-80 mix-blend-multiply md:mt-12 md:w-[140px]"
        />
      </div>
    </Grid>
  </Section>

  <!-- ORIENTATION · linen, three columns divided by hairlines -->
  <Section mode="linen" data-reveal class="pb-14 md:pb-20 lg:pb-24">
    <Grid class="border-t border-rule">
      {
        orientation.map((o, i) => (
          <div class:list={['py-6 md:py-7 lg:col-span-4 lg:py-10 lg:pr-8', i > 0 && 'border-t border-rule lg:border-t-0 lg:border-l lg:pl-8']}>
            <div class="eyebrow mb-3">{o.label}</div>
            <p class="font-display text-title text-ink">{o.detail}</p>
          </div>
        ))
      }
    </Grid>
  </Section>

  <!-- OUR STORY TEASER · burlap — the one warm interlude. On a phone it is the Our Story band: the line written
       over the photo, at the top of the frame above the couple. From sm it mirrors the hero instead: text 1–5,
       photo 7–12. Two renders of the same photo; the hidden one is lazy and never requested. -->
  <Interlude
    class="sm:hidden"
    photo={storyPhoto}
    alt={storyAlt}
    position="50% 75%"
    ratio="4/5"
    mode="burlap"
    kicker="Our Story"
    quote="It started with a sleeve."
    link={{ href: '/our-story', label: 'Read our story →' }}
  />
  <!-- From sm: an editorial spread. Text inset to columns 2–5 and centred on the photo; the quote is sized to
       break as two even lines, one line of the story follows it, and the photo carries the Interlude's inset
       hairline so the phone band and this spread read as the same object. -->
  <Section mode="burlap" data-reveal class="hidden py-14 sm:block md:py-20 lg:py-24">
    <Grid class="gap-y-8 sm:grid-cols-12 sm:gap-x-6 lg:gap-y-10">
      <div class="order-2 sm:order-1 sm:col-span-5 sm:self-center lg:col-start-2 lg:col-span-4">
        <div class="mb-6 flex items-center gap-x-4 lg:mb-8">
          <span aria-hidden="true" class="h-px w-8 flex-none bg-ink"></span>
          <div class="eyebrow">Our Story</div>
        </div>
        <p class="mb-6 max-w-[15ch] font-display italic font-medium text-quote text-ink lg:mb-7 lg:text-display">It started with a sleeve.</p>
        <p class="mb-8 max-w-[30ch] font-display text-lead text-ink lg:mb-10">One chilly evening in June, Joanique took off her jacket and caught Pieter across the face. All she had to do was say hi.</p>
        <a href="/our-story" class="nav-link inline-flex text-ink underline underline-offset-[0.3em] hover:opacity-75">Read our story →</a>
      </div>
      <div class="relative order-1 aspect-[4/5] overflow-hidden sm:order-2 sm:col-start-7 sm:col-span-6 lg:col-start-7 lg:col-span-5">
        <Image src={storyPhoto} alt={storyAlt} widths={[640, 1024, 1600]} sizes="(min-width: 1024px) 42vw, 50vw" class="absolute inset-0 h-full w-full object-cover" />
        <div class="pointer-events-none absolute inset-3 border lg:inset-5" style="border-color:color-mix(in srgb, var(--color-surface) 70%, transparent);"></div>
      </div>
    </Grid>
  </Section>

  <!-- A FEW MOMENTS · linen, three equal portraits on one baseline. On a phone
       the three become a swipeable strip with the next frame peeking in from
       the right edge, instead of three full-width portraits stacked. -->
  <Section mode="linen" data-reveal class="py-14 md:py-20 lg:py-24">
    <Grid class="gap-y-5 lg:gap-y-6">
      <div class="flex items-baseline justify-between gap-x-4 lg:col-span-12 lg:mb-2">
        <div class="eyebrow">A Few Moments So Far</div>
        <a href="/gallery" class="nav-link whitespace-nowrap text-ink underline underline-offset-[0.3em] hover:opacity-75">
          <span class="sm:hidden">Gallery →</span>
          <span class="hidden sm:inline">See the gallery →</span>
        </a>
      </div>
      <div class="scroll-strip -mx-5 flex snap-x snap-mandatory gap-4 overflow-x-auto px-5 scroll-px-5 sm:mx-0 sm:grid sm:grid-cols-3 sm:gap-5 sm:overflow-visible sm:px-0 lg:col-span-12 lg:gap-6">
        {
          moments.map((m) => (
            <div class="relative aspect-[4/5] w-[76%] flex-none snap-start overflow-hidden sm:w-auto">
              <Image src={m.src} alt={m.alt} widths={[480, 800, 1200]} sizes="(min-width: 640px) 33vw, 76vw" class="absolute inset-0 h-full w-full object-cover" />
            </div>
          ))
        }
      </div>
    </Grid>
  </Section>

  <Footer />
</Base>
