---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Section from '../components/site/Section.astro';
import Grid from '../components/site/Grid.astro';
import Nav from '../components/site/Nav.astro';
import Footer from '../components/site/Footer.astro';
import hero from '../assets/photos/photo-6.jpg';
import storyPhoto from '../assets/photos/gallery/g-15.jpg';
import moment1 from '../assets/photos/gallery/g-30.jpg';
import moment2 from '../assets/photos/gallery/g-19.jpg';
import moment3 from '../assets/photos/gallery/g-46.jpg';
import { RSVP_DEADLINE } from '../lib/pricing';

export const prerender = true;

// One ground (linen), hairline rules between sections, and a mode change used
// as an event: burlap once for the Our Story teaser, olive only for the footer.
const orientation = [
  { label: 'The Weekend', detail: 'Friday 13 to Sunday 15 November 2026' },
  { label: 'The Place', detail: 'Tshikwalo Game Lodge, Dinokeng Game Reserve' },
  { label: 'RSVP by', detail: '28 September 2026' },
];

const moments = [
  { src: moment1, alt: 'Pieter and Joanique holding hands in a doorway, framed by white walls with a parquet floor beneath them.' },
  { src: moment2, alt: 'Black and white photograph of Pieter and Joanique in a close embrace, foreheads almost touching, beside framed prints.' },
  { src: moment3, alt: 'Pieter dipping Joanique in a dance in front of a teal gallery wall, her heel kicked up behind her.' },
];
---

<Base title="Pieter & Joanique — 14 November 2026">
  <Nav />

  <!-- HERO · linen. Asymmetric split: photo columns 1–7, masthead 8–12; stacked below lg. -->
  <Section mode="linen" class="pt-5 md:pt-10 lg:pt-0">
    <Grid class="lg:min-h-[640px] lg:h-[calc(100svh-5.5rem)] lg:max-h-[880px]">
      <div class="relative aspect-[4/5] overflow-hidden lg:col-span-7 lg:aspect-auto lg:h-full">
        <Image
          src={hero}
          alt="Pieter and Joanique, nose to nose, seated on a bench in a white gallery."
          widths={[640, 1024, 1600, 2400]}
          sizes="(min-width: 1024px) 58vw, 100vw"
          loading="eager"
          fetchpriority="high"
          class="absolute inset-0 h-full w-full object-cover"
          style="object-position: 50% 42%;"
        />
      </div>
      <div class="flex flex-col justify-center py-10 md:py-14 lg:col-span-5 lg:py-16 lg:pl-8 xl:pl-16">
        <div class="eyebrow mb-6">Saturday · 14 November 2026</div>
        <h1 class="mb-5 font-display font-medium text-display text-ink">
          Pieter <span class="italic font-normal">&amp;</span> Joanique
        </h1>
        <p class="mb-10 max-w-[26ch] font-display text-lead text-ink">Tshikwalo Game Lodge, Dinokeng Game Reserve</p>
        <div class="border-t border-rule pt-8">
          <a
            href="/rsvp"
            class="flex min-h-[64px] w-full max-w-[420px] items-center justify-center bg-ink px-8 font-body font-medium uppercase tracking-[0.18em] text-body text-surface transition-colors hover:bg-accent"
            >RSVP</a
          >
          <p class="mt-4 font-body text-small text-ink">Kindly respond by {RSVP_DEADLINE}.</p>
        </div>
      </div>
    </Grid>
  </Section>

  <!-- A NOTE FROM US · linen, contained editorial: kicker in column 2, body columns 3–9 -->
  <Section mode="linen" data-reveal class="py-16 md:py-20 lg:py-24">
    <Grid class="border-t border-rule pt-10 lg:pt-14">
      <div class="eyebrow mb-6 lg:col-start-2 lg:col-span-1 lg:mb-0">A Note<br class="hidden lg:inline" /> From Us</div>
      <div class="lg:col-start-3 lg:col-span-7">
        <p class="mb-8 max-w-[64ch] font-display text-lead text-ink">
          We are truly grateful to have you celebrate our special day with us. Each of you was intentionally invited, and we
          look forward to seeing you all. We cannot wait to build lasting memories and have you be part of them.
        </p>
        <p class="font-display italic text-title text-ink">With love, Pieter &amp; Joanique</p>
      </div>
    </Grid>
  </Section>

  <!-- ORIENTATION · linen, three columns divided by hairlines -->
  <Section mode="linen" data-reveal class="pb-16 md:pb-20 lg:pb-24">
    <Grid class="border-t border-rule">
      {
        orientation.map((o, i) => (
          <div class:list={['py-7 lg:col-span-4 lg:py-10 lg:pr-8', i > 0 && 'border-t border-rule lg:border-t-0 lg:border-l lg:pl-8']}>
            <div class="eyebrow mb-3">{o.label}</div>
            <p class="font-display text-title text-ink">{o.detail}</p>
          </div>
        ))
      }
    </Grid>
  </Section>

  <!-- OUR STORY TEASER · burlap — the one warm interlude. Mirrors the hero: text 1–5, photo 7–12. -->
  <Section mode="burlap" data-reveal class="py-16 md:py-20 lg:py-24">
    <Grid class="gap-y-10">
      <div class="order-2 lg:order-1 lg:col-span-5 lg:self-center lg:pt-24">
        <div class="eyebrow mb-6">Our Story</div>
        <p class="mb-8 max-w-[22ch] font-display italic font-medium text-quote text-ink">Officially, it was just coffee.</p>
        <a href="/our-story" class="nav-link inline-flex text-ink underline underline-offset-[0.3em] hover:opacity-75">Read our story →</a>
      </div>
      <div class="relative order-1 aspect-[4/5] overflow-hidden lg:order-2 lg:col-start-7 lg:col-span-6">
        <Image
          src={storyPhoto}
          alt="Pieter and Joanique smiling at the camera, her hand on his chest, in front of framed artworks on a green gallery wall."
          widths={[640, 1024, 1600]}
          sizes="(min-width: 1024px) 50vw, 100vw"
          class="absolute inset-0 h-full w-full object-cover"
        />
      </div>
    </Grid>
  </Section>

  <!-- A FEW MOMENTS · linen, three equal portraits on one baseline -->
  <Section mode="linen" data-reveal class="py-16 md:py-20 lg:py-24">
    <Grid class="gap-y-6">
      <div class="mb-2 flex items-baseline justify-between lg:col-span-12">
        <div class="eyebrow">A Few Moments So Far</div>
        <a href="/gallery" class="nav-link text-ink underline underline-offset-[0.3em] hover:opacity-75">See the gallery →</a>
      </div>
      <div class="grid grid-cols-1 gap-5 sm:grid-cols-3 lg:col-span-12 lg:gap-6">
        {
          moments.map((m) => (
            <div class="relative aspect-[4/5] overflow-hidden">
              <Image src={m.src} alt={m.alt} widths={[480, 800, 1200]} sizes="(min-width: 640px) 33vw, 100vw" class="absolute inset-0 h-full w-full object-cover" />
            </div>
          ))
        }
      </div>
    </Grid>
  </Section>

  <Footer />
</Base>
