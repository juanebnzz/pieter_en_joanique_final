---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Section from '../components/site/Section.astro';
import Grid from '../components/site/Grid.astro';
import Nav from '../components/site/Nav.astro';
import Footer from '../components/site/Footer.astro';
import hero from '../assets/photos/gallery/g-44.jpg';
import storyPhoto from '../assets/photos/gallery/g-15.jpg';
import moment1 from '../assets/photos/gallery/g-30.jpg';
import moment2 from '../assets/photos/gallery/g-19.jpg';
import moment3 from '../assets/photos/gallery/g-46.jpg';

export const prerender = true;

// One ground (linen), hairline rules between sections, and a mode change used
// as an event: the hero and footer are olive, burlap once for the Our Story teaser.

// Hero overlays resolve toward the section's own surface colour.
const heroScrim =
  'background:linear-gradient(to bottom, color-mix(in srgb, var(--color-surface) 0%, transparent) 35%, color-mix(in srgb, var(--color-surface) 55%, transparent) 70%, color-mix(in srgb, var(--color-surface) 85%, transparent) 100%);';
const navScrim =
  'background:linear-gradient(to bottom, color-mix(in srgb, var(--color-surface) 45%, transparent) 0%, color-mix(in srgb, var(--color-surface) 0%, transparent) 100%);';
const orientation = [
  { label: 'The Weekend', detail: 'Friday 13 to Sunday 15 November 2026' },
  { label: 'The Place', detail: 'Tshikwalo Game Lodge, Dinokeng Game Reserve' },
  { label: 'RSVP by', detail: '28 September 2026' },
];

const moments = [
  { src: moment1, alt: 'Pieter and Joanique holding hands in a doorway, framed by white walls with a parquet floor beneath them.' },
  { src: moment2, alt: 'Black and white photograph of Pieter and Joanique in a close embrace, foreheads almost touching, beside framed prints.' },
  { src: moment3, alt: 'Pieter dipping Joanique in a dance in front of a teal gallery wall, her heel kicked up behind her.' },
];
---

<Base title="Pieter & Joanique · 14 November 2026">
  <!-- Sticky overlay nav: a sibling of the hero, not a child, because the hero clips overflow -->
  <Nav variant="overlay" mode="olive" />

  <!-- HERO · olive (g-44), full bleed under the overlay nav — kept exactly as the couple want it -->
  <Section mode="olive" class="relative m-0 h-[84vh] min-h-[600px] w-full overflow-hidden">
    <Image
      src={hero}
      alt="Pieter and Joanique"
      widths={[640, 1024, 1600, 2400]}
      sizes="100vw"
      loading="eager"
      fetchpriority="high"
      class="absolute inset-0 block h-full w-full object-cover"
    />
    <div class="pointer-events-none absolute inset-0" style={heroScrim}></div>
    <div class="pointer-events-none absolute left-0 right-0 top-0 h-[26cqw] min-h-[120px]" style={navScrim}></div>
    <div class="pointer-events-none absolute bottom-0 left-0 right-0 px-[6cqw] pb-[6cqw] pt-[8cqw] text-center">
      <h1 class="mb-[0.5em] font-display font-medium leading-[1.05] tracking-[0.02em] text-ink text-[clamp(2.2rem,9cqw,5rem)]">
        PIETER &amp; JOANIQUE
      </h1>
      <p class="mb-[0.35em] font-body tracking-[0.04em] text-ink text-[clamp(1rem,2.4cqw,1.25rem)]">Saturday, 14 November 2026</p>
      <p class="mb-[1.6em] whitespace-nowrap font-body tracking-[0.04em] text-ink text-[clamp(0.95rem,2.2cqw,1.15rem)]">
        Tshikwalo Game Lodge, Dinokeng Game Reserve
      </p>
      <a
        href="/rsvp"
        class="pointer-events-auto mx-auto flex min-h-[64px] w-full max-w-[520px] flex-col items-center justify-center gap-[0.15em] bg-ink px-[1.5em] py-[1em] text-surface transition-opacity hover:opacity-85"
      >
        <span class="font-body font-medium uppercase tracking-[0.18em] text-[clamp(1rem,2.6cqw,1.25rem)]">RSVP</span>
        <span class="font-body text-[0.78rem] tracking-[0.05em]">Kindly respond by 28 September 2026</span>
      </a>
    </div>
  </Section>

  <!-- A NOTE FROM US · linen, centred in columns 4–9, with generous space before the orientation strip -->
  <Section mode="linen" data-reveal class="pt-16 pb-24 md:pt-20 md:pb-32 lg:pt-24 lg:pb-40">
    <Grid class="border-t border-rule pt-14 lg:pt-20">
      <div class="text-center lg:col-start-4 lg:col-span-6">
        <div class="eyebrow mb-8">A Note From Us</div>
        <p class="mx-auto mb-8 max-w-[52ch] font-display text-lead text-ink">
          We are truly grateful to have you celebrate our special day with us. Each of you was intentionally invited, and we
          look forward to seeing you all. We cannot wait to build lasting memories and have you be part of them.
        </p>
        <p class="font-display italic text-title text-ink">With love, Pieter &amp; Joanique</p>
      </div>
    </Grid>
  </Section>

  <!-- ORIENTATION · linen, three columns divided by hairlines -->
  <Section mode="linen" data-reveal class="pb-16 md:pb-20 lg:pb-24">
    <Grid class="border-t border-rule">
      {
        orientation.map((o, i) => (
          <div class:list={['py-7 lg:col-span-4 lg:py-10 lg:pr-8', i > 0 && 'border-t border-rule lg:border-t-0 lg:border-l lg:pl-8']}>
            <div class="eyebrow mb-3">{o.label}</div>
            <p class="font-display text-title text-ink">{o.detail}</p>
          </div>
        ))
      }
    </Grid>
  </Section>

  <!-- OUR STORY TEASER · burlap — the one warm interlude. Mirrors the hero: text 1–5, photo 7–12. -->
  <Section mode="burlap" data-reveal class="py-16 md:py-20 lg:py-24">
    <Grid class="gap-y-10">
      <div class="order-2 lg:order-1 lg:col-span-5 lg:self-center lg:pt-24">
        <div class="eyebrow mb-6">Our Story</div>
        <p class="mb-8 max-w-[22ch] font-display italic font-medium text-quote text-ink">Officially, it was just coffee.</p>
        <a href="/our-story" class="nav-link inline-flex text-ink underline underline-offset-[0.3em] hover:opacity-75">Read our story →</a>
      </div>
      <div class="relative order-1 aspect-[4/5] overflow-hidden lg:order-2 lg:col-start-7 lg:col-span-6">
        <Image
          src={storyPhoto}
          alt="Pieter and Joanique smiling at the camera, her hand on his chest, in front of framed artworks on a green gallery wall."
          widths={[640, 1024, 1600]}
          sizes="(min-width: 1024px) 50vw, 100vw"
          class="absolute inset-0 h-full w-full object-cover"
        />
      </div>
    </Grid>
  </Section>

  <!-- A FEW MOMENTS · linen, three equal portraits on one baseline -->
  <Section mode="linen" data-reveal class="py-16 md:py-20 lg:py-24">
    <Grid class="gap-y-6">
      <div class="mb-2 flex items-baseline justify-between lg:col-span-12">
        <div class="eyebrow">A Few Moments So Far</div>
        <a href="/gallery" class="nav-link text-ink underline underline-offset-[0.3em] hover:opacity-75">See the gallery →</a>
      </div>
      <div class="grid grid-cols-1 gap-5 sm:grid-cols-3 lg:col-span-12 lg:gap-6">
        {
          moments.map((m) => (
            <div class="relative aspect-[4/5] overflow-hidden">
              <Image src={m.src} alt={m.alt} widths={[480, 800, 1200]} sizes="(min-width: 640px) 33vw, 100vw" class="absolute inset-0 h-full w-full object-cover" />
            </div>
          ))
        }
      </div>
    </Grid>
  </Section>

  <Footer />
</Base>
