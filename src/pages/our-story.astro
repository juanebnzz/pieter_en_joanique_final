---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import Base from "../layouts/Base.astro";
import Section from "../components/site/Section.astro";
import Grid from "../components/site/Grid.astro";
import PageIntro from "../components/site/PageIntro.astro";
import Nav from "../components/site/Nav.astro";
import Footer from "../components/site/Footer.astro";
import Interlude from "../components/site/Interlude.astro";
import ch1 from "../assets/photos/gallery/g-37.jpg";
import ch2 from "../assets/photos/gallery/g-04.jpg";
import ch3 from "../assets/photos/gallery/g-31.jpg";
import ch4 from "../assets/photos/gallery/g-25.jpg";
import ch5 from "../assets/photos/gallery/g-32.jpg";
import bandPhoto from "../assets/photos/gallery/g-11.jpg";
import introPhoto from "../assets/photos/gallery/g-21.jpg";

export const prerender = true;

// Chapters are asymmetric splits that alternate image side so the page
// zigzags — a 5/7 split from sm, 6/5 with the text offset from lg. The "01 · date" kicker is the spine. `body` is the couple's own
// telling, in short paragraphs; it is meant to be read, and to be kept.
const chapters: {
  label: string;
  oversized: string;
  body: string[];
  src: ImageMetadata;
  alt: string;
  position: string;
  bandAfter: boolean;
}[] = [
  {
    label: "01 · The Introduction",
    oversized:
      "There was no need to slap him with her sleeve. All she had to do was say hi.",
    body: [
      "On a chilly evening on 25 June 2024, Pieter and Joanique attended the same church course, neither knowing that the evening would become the beginning of their story.",
      "Pieter happened to sit directly behind Joanique. As the room warmed up, Joanique took off her jacket and accidentally slapped Pieter across the face with her sleeve. Not quite the elegant first impression she had imagined!",
      "Rather than being offended, Pieter cheekily told her there was no need to slap him with her sleeve; all she had to do was say hi. Caught off guard, Joanique spent much of the evening trying not to smile.",
      "Pieter remembers very little of what was taught that night. His attention was far more occupied by the beautiful girl sitting in front of him.",
      "Joanique still reminds him that paying attention in church is important.",
    ],
    src: ch1,
    alt: "Black and white close-up of Pieter and Joanique nose to nose, her hand resting on his cheek.",
    position: "50% 40%",
    bandAfter: false,
  },
  {
    label: "02 · Sunday Coffees",
    oversized: "Pieter was patient, kind, and very persistent.",
    body: [
      "After the course, Joanique wasn't entirely convinced that anything was happening. The first few weeks included a handful of blue-ticked messages as she took her time getting to know Pieter.",
      "Thankfully, Pieter was patient, kind, and very persistent.",
      "Pieter, meanwhile, was convinced from the beginning. He tried to appear cool and composed, but was already completely smitten. Joanique saw straight through him and, fortunately, found it rather sweet.",
      "Their Sunday coffees soon became a weekly excuse to spend more time together, and with every coffee, Joanique found herself falling a little more for Pieter.",
      "Then came their first official coffee date, and everything changed.",
    ],
    src: ch2,
    alt: "Joanique twirling in a white dress in front of a wall of colourful paintings while Pieter watches.",
    position: "50% 50%",
    bandAfter: false,
  },
  {
    label: "03 · The First Date",
    oversized:
      "Somewhere between coffee and laughter, something special was happening.",
    body: [
      "At Tashas, on a cool Friday evening, somewhere between coffee, easy conversation, and plenty of laughter, they began to realise that something special was happening.",
      "Joanique fell in love with Pieter's unwavering confidence in the Lord, his kind heart, and the joy he brings wherever he goes. Pieter fell in love with Joanique's genuine relationship with God, her loving heart, sharp one-liners, and the way she cares deeply for others.",
      "As they got to know each other, there were plenty more dates and memories, including a driving-range date where Joanique outdrove Pieter, and a go-karting date which Pieter won largely because he had watched YouTube videos on the ideal racing line beforehand.",
      "Before long, Pieter decided it was time to make official what was already taking place in both their hearts.",
    ],
    src: ch3,
    alt: "Black and white photograph of Pieter and Joanique standing hand in hand in a gallery doorway, both smiling.",
    position: "50% 60%",
    bandAfter: false,
  },
  {
    label: "04 · Making It Official",
    oversized: "There was one small problem. Joanique doesn't like cheese.",
    body: [
      "Pieter booked a day at Van Gaalen Cheese Farm: a cheese-tasting tour followed by a romantic picnic beside a stream.",
      "There was just one small problem: Joanique doesn't actually like cheese.",
      "Nevertheless, the day was filled with laughter and fun. After the tasting, Pieter took Joanique to the picnic spot, where another cheese platter was waiting, along with a large stuffed penguin who would later be named Frik.",
      "Beside the stream, Pieter asked Joanique to be his.",
      "Her answer was immediate.",
      "“Yes.”",
      "And so began a new chapter filled with adventures and ordinary moments that became memories of their own.",
      "Their first holiday was a Cape Town road trip in a tiny Hyundai i10 named Elsie, followed by a Kruger adventure where Joanique began to wonder if Pieter was more excited about spotting a rare bird than spending time with her. Their first overseas trip was to Dubai, eating dates between palm trees, having picnics in the dunes, and drinking karak on the street in the early mornings on their way home.",
      "Between Murder Mystery nights, squash tournaments, late-night drives, pizza, ice cream, Boeremark coffees, Warrior Races, Clivia Markets and padel, they simply enjoyed doing life together.",
    ],
    src: ch4,
    alt: "Joanique laughing with her arms around Pieter's neck in a bright gallery corridor.",
    position: "50% 35%",
    bandAfter: true,
  },
  {
    label: "05 · The Proposal",
    oversized: "Of course, there would be no family breakfast.",
    body: [
      "After nearly two years together, Pieter decided it was time to ask Joanique to marry him.",
      "The idea began during a visit to a possible wedding venue, when Pieter spotted a pamphlet advertising a romantic bushveld picnic and discreetly slipped it into his pocket. From there, the planning involved photographers, venue emails, satellite imagery and plenty of secret coordination.",
      "The cover story was a family breakfast at the venue. Of course, there would be no family breakfast. There would be a picnic instead, followed by a very important question.",
      "Keeping the secret proved harder than expected. Joanique has a remarkable ability to spot a logistical gap, forcing Pieter to come up with increasingly creative explanations, including a dog-school graduation in Krugersdorp and her father's car apparently losing a piston.",
      "Eventually, they arrived at the venue. Things were going according to plan. Until they weren't.",
      "Sharon, their wedding planner and “woman on the inside”, was busy with another couple, leaving Pieter and Joanique waiting over coffee. Sharon eventually created the perfect opportunity for Pieter to slip away, ring in hand, heart racing and hands trembling.",
      "Somehow, despite all the suspicious explanations and questionable logistics, Joanique still didn't figure it out.",
      "Then Pieter saw her.",
      "Joanique emerged through the trees, and the moment they saw each other, they both burst into tears.",
      "Her first words were:",
      "“Is hierdie ons?”",
      "Pieter got down on one knee and asked her to spend the rest of their lives together.",
      "She said yes.",
    ],
    src: ch5,
    alt: "Pieter's hand reaching for Joanique's across a parquet floor, her engagement ring catching the light.",
    position: "50% 50%",
    bandAfter: false,
  },
];
---

<Base
  title="Our Story · Pieter & Joanique"
  description="How Pieter and Joanique met, from a sleeve across the face at a church course to a bushveld picnic and a very important question, told in five chapters."
>
  <Nav />

  <PageIntro
    kicker="Our Story"
    title="How it"
    flourish="happened"
    lead="Five chapters, in our own words."
    caption="Over her shoulder"
    photo={introPhoto}
    alt="Joanique looking back over her shoulder at Pieter, smiling, in front of a green gallery wall of framed prints."
    ratio="5/6"
    position="50% 30%"
    anchor
    detail="Since 25 June 2024"
    facts={chapters.map((c, i) => {
      const [n, t] = c.label.split(" · ");
      return { label: n, value: t, href: `#chapter-${i + 1}` };
    })}
  >
    <p
      slot="foot"
      class="m-0 max-w-[44ch] font-display italic text-lead text-ink"
    >
      It started with a sleeve, one chilly evening in June.
    </p>
  </PageIntro>

  {
    chapters.map((c, i) => {
      const photoLeft = i % 2 === 0;
      return (
        <>
          <Section
            id={`chapter-${i + 1}`}
            mode="linen"
            data-reveal="lift"
            class="scroll-mt-16 py-10 md:py-14 lg:py-16"
          >
            <Grid class="gap-y-6 border-t border-rule pt-8 sm:grid-cols-12 sm:gap-x-6 md:pt-10 lg:gap-y-8 lg:pt-14">
              <div
                class:list={[
                  "relative aspect-[4/5] overflow-hidden sm:row-start-1 sm:aspect-[2/3]",
                  photoLeft
                    ? "sm:col-start-1 sm:col-span-5 lg:col-span-6"
                    : "sm:col-start-8 sm:col-span-5 lg:col-start-7 lg:col-span-6",
                ]}
              >
                <Image
                  src={c.src}
                  alt={c.alt}
                  widths={[640, 1024, 1600]}
                  sizes="(min-width: 1024px) 50vw, 100vw"
                  class="absolute inset-0 h-full w-full object-cover"
                  style={`object-position:${c.position};`}
                />
              </div>
              {/* The text block sits below the image top — the offset is what keeps it from reading as a template. */}
              <div
                class:list={[
                  "sm:row-start-1 sm:self-start sm:pt-6 md:pt-10 lg:pt-24",
                  photoLeft
                    ? "sm:col-start-7 sm:col-span-6 lg:col-start-8 lg:col-span-5"
                    : "sm:col-start-1 sm:col-span-6 lg:col-span-5",
                ]}
              >
                <div class="eyebrow mb-5 lg:mb-6">{c.label}</div>
                <p class="mb-6 max-w-[24ch] font-display italic font-medium text-quote text-ink lg:mb-8">
                  {c.oversized}
                </p>
                {c.body.map((para) => (
                  <p class="mb-5 max-w-[60ch] font-display text-lead text-ink last:mb-0">
                    {para}
                  </p>
                ))}
              </div>
            </Grid>
          </Section>

          {/* INTERSTITIAL · olive, full bleed. On desktop the line sits over the empty floor at right; on a phone it
              sits at the top of the frame over the wall, above the couple. */}
          {c.bandAfter && (
            <Interlude
              photo={bandPhoto}
              position="50% 90%"
              mode="olive"
              kicker="Jeremiah 29:11"
              quote="Through every laugh, every adventure, every challenge and every ordinary moment in between, Jeremiah 29:11 has been a constant reminder that God has a plan for their lives."
              align="right"
            />
          )}
        </>
      );
    })
  }

  <!-- CLOSING · burlap. The coda is set like a chapter opener turned to face the reader: centred, a short rule,
       a kicker, the sentence split so the display line carries its last clause, and one quiet pointer onward,
       since the next chapter is literally the weekend. -->
  <Section mode="burlap" data-reveal="lift" class="py-16 md:py-24 lg:py-32">
    <Grid>
      <div class="text-center lg:col-start-3 lg:col-span-8">
        <span aria-hidden="true" class="mx-auto mb-6 block h-px w-10 bg-ink lg:mb-8"></span>
        <div class="eyebrow mb-6 lg:mb-8">And Now</div>
        <p class="mx-auto mb-6 max-w-[44ch] text-balance font-display text-lead text-ink lg:mb-8">
          After all the coffees, dates, adventures, laughter and memories, Pieter and Joanique find themselves
          standing on the doorstep of the next chapter of their story.
        </p>
        <p class="mx-auto mb-10 max-w-[28ch] text-balance font-display italic font-medium text-quote text-ink lg:mb-12">
          One they never could have planned for themselves, but one that God had been writing all along.
        </p>
        <a href="/the-weekend" class="nav-link inline-flex text-ink underline underline-offset-[0.3em] hover:opacity-75">
          13 to 15 November 2026 · The Weekend →
        </a>
      </div>
    </Grid>
  </Section>

  <Footer />
</Base>
