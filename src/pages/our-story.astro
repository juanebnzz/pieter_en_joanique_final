---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Base from '../layouts/Base.astro';
import Section from '../components/site/Section.astro';
import Grid from '../components/site/Grid.astro';
import PageIntro from '../components/site/PageIntro.astro';
import Nav from '../components/site/Nav.astro';
import Footer from '../components/site/Footer.astro';
import ch1 from '../assets/photos/gallery/g-37.jpg';
import ch2 from '../assets/photos/gallery/g-02.jpg';
import ch3 from '../assets/photos/gallery/g-32.jpg';
import ch4 from '../assets/photos/gallery/g-25.jpg';
import bandPhoto from '../assets/photos/gallery/g-11.jpg';

export const prerender = true;

// Chapters are asymmetric splits that alternate image side so the page
// zigzags. The "01 · date" kicker is the spine. `body` is the chapter prose
// beneath the oversized line; it is optional until the couple's copy lands.
const chapters: { label: string; oversized: string; body?: string; src: ImageMetadata; alt: string; position: string; bandAfter: boolean }[] = [
  {
    label: '01 · 25 June 2024',
    oversized: 'There was really no need to slap him with her sleeve. All she had to do was say hi.',
    src: ch1,
    alt: 'Black and white close-up of Pieter and Joanique nose to nose, her hand resting on his cheek.',
    position: '50% 40%',
    bandAfter: false,
  },
  {
    label: '02 · The Coffees',
    oversized: 'Officially, it was just coffee.',
    src: ch2,
    alt: 'Pieter and Joanique walking hand in hand through a white gallery hung with colourful paintings.',
    position: '50% 50%',
    bandAfter: true,
  },
  {
    label: '03 · The Proposal',
    oversized: 'There was one small problem. Joanique does not like cheese.',
    src: ch3,
    alt: "Pieter's hand reaching for Joanique's across a parquet floor, her engagement ring catching the light.",
    position: '50% 50%',
    bandAfter: false,
  },
  {
    label: '04 · Since Then',
    oversized: 'She outdrove him. He has never been allowed to forget it.',
    src: ch4,
    alt: 'Joanique laughing with her arms around Pieter\'s neck in a bright gallery corridor.',
    position: '50% 35%',
    bandAfter: false,
  },
];
---

<Base title="Our Story — Pieter & Joanique">
  <Nav />

  <PageIntro kicker="Our Story" title="How it happened" />

  {
    chapters.map((c, i) => {
      const photoLeft = i % 2 === 0;
      return (
        <>
          <Section mode="linen" data-reveal="lift" class="py-12 md:py-14 lg:py-16">
            <Grid class="gap-y-8 border-t border-rule pt-10 lg:pt-14">
              <div class:list={['relative aspect-[4/5] overflow-hidden lg:row-start-1', photoLeft ? 'lg:col-start-1 lg:col-span-6' : 'lg:col-start-7 lg:col-span-6']}>
                <Image src={c.src} alt={c.alt} widths={[640, 1024, 1600]} sizes="(min-width: 1024px) 50vw, 100vw" class="absolute inset-0 h-full w-full object-cover" style={`object-position:${c.position};`} />
              </div>
              {/* The text block sits below the image top — the offset is what keeps it from reading as a template. */}
              <div class:list={['lg:row-start-1 lg:self-start lg:pt-24', photoLeft ? 'lg:col-start-8 lg:col-span-5' : 'lg:col-start-1 lg:col-span-5']}>
                <div class="eyebrow mb-6">{c.label}</div>
                <p class:list={['max-w-[24ch] font-display italic font-medium text-quote text-ink', c.body && 'mb-8']}>{c.oversized}</p>
                {c.body && <p class="max-w-[64ch] font-display text-lead text-ink">{c.body}</p>}
              </div>
            </Grid>
          </Section>

          {/* INTERSTITIAL · olive, full bleed; anchored to the bottom of the aerial frame so the couple stay in shot, with the line over the empty floor at right */}
          {c.bandAfter && (
            <Section mode="olive" data-reveal="lift" class="relative w-full overflow-hidden">
              <div class="relative aspect-[4/5] w-full md:aspect-[3/2] lg:aspect-[16/9] lg:max-h-[760px]">
                <Image src={bandPhoto} alt="" widths={[800, 1400, 2400]} sizes="100vw" class="absolute inset-0 h-full w-full object-cover" style="object-position:50% 90%;" />
                <div class="pointer-events-none absolute inset-0 hidden lg:block" style="background:linear-gradient(to top, color-mix(in srgb, var(--color-surface) 75%, transparent) 0%, color-mix(in srgb, var(--color-surface) 0%, transparent) 65%);" />
              </div>
              {/* Below lg the line sits beneath the photo; from lg it overlays the empty floor at right. */}
              <div class="py-10 lg:absolute lg:inset-x-0 lg:bottom-0 lg:py-0">
                <Grid class="lg:pb-16">
                  <p class="max-w-[26ch] font-display italic text-quote text-ink lg:col-start-8 lg:col-span-5">
                    Jeremiah 29:11 has been a constant reminder that God has a plan for their lives.
                  </p>
                </Grid>
              </div>
            </Section>
          )}
        </>
      );
    })
  }

  <!-- CLOSING · burlap — the one interlude, and the line stands alone -->
  <Section mode="burlap" data-reveal="lift" class="py-20 md:py-24 lg:py-32">
    <Grid>
      <p class="font-display italic text-display text-ink lg:col-start-3 lg:col-span-8">Slegs goeie besluite</p>
    </Grid>
  </Section>

  <Footer />
</Base>
