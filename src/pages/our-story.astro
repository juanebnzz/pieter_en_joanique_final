---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Base from '../layouts/Base.astro';
import Section, { type Mode } from '../components/site/Section.astro';
import Nav from '../components/site/Nav.astro';
import Footer from '../components/site/Footer.astro';
import photo7 from '../assets/photos/photo-7.jpg';
import photo8 from '../assets/photos/photo-8.jpg';
import photo9 from '../assets/photos/photo-9.jpg';
import photo10 from '../assets/photos/photo-10.jpg';
import photo11 from '../assets/photos/photo-11.jpg';

export const prerender = true;

// Each chapter's mode follows the wall tone of its photograph: white → linen,
// cream → burlap, emerald / charcoal → olive. Chapter 03 (charcoal) would be
// olive, but it follows the olive quote band, so it takes burlap instead.
// `body` is the chapter prose beneath the oversized line. It is optional so a
// chapter renders cleanly while its copy is still with the couple.
const chapters: { label: string; oversized: string; body?: string; src: ImageMetadata; mode: Mode; bandAfter: boolean }[] = [
  {
    label: '01 · 25 June 2024',
    oversized: 'There was really no need to slap him with her sleeve. All she had to do was say hi.',
    src: photo8, // cream walls
    mode: 'burlap',
    bandAfter: false,
  },
  {
    label: '02 · The Coffees',
    oversized: 'Officially, it was just coffee.',
    src: photo9, // white walls
    mode: 'linen',
    bandAfter: true,
  },
  {
    label: '03 · The Proposal',
    oversized: 'There was one small problem. Joanique does not like cheese.',
    src: photo11, // charcoal wall — olive by tone, burlap by adjacency
    mode: 'burlap',
    bandAfter: false,
  },
  {
    label: '04 · Since Then',
    oversized: 'She outdrove him. He has never been allowed to forget it.',
    src: photo7, // white walls
    mode: 'linen',
    bandAfter: false,
  },
];

const bandScrim =
  'background:linear-gradient(to bottom, color-mix(in srgb, var(--color-surface) 15%, transparent) 0%, color-mix(in srgb, var(--color-surface) 55%, transparent) 100%);';
---

<Base title="Our Story — Pieter & Joanique">
  <Nav />

  {
    chapters.map((c, i) => (
      <>
        <Section mode={c.mode} data-reveal="lift" class="px-[6cqw] py-[6cqw]">
          {/* On wide screens chapters alternate image/text; on narrow, image always leads. */}
          <div class:list={['mx-auto flex max-w-[1040px] flex-wrap items-center gap-[5cqw]', i % 2 === 1 && 'flex-row-reverse']}>
            <div class="min-w-[260px] flex-[1_1_300px] overflow-hidden" style="aspect-ratio:4/5;">
              <Image src={c.src} alt="Pieter and Joanique" widths={[480, 800, 1200]} sizes="(min-width: 1120px) 470px, (min-width: 700px) 45vw, 100vw" class="h-full w-full object-cover" />
            </div>
            <div class="min-w-[260px] flex-[1_1_300px]">
              <div class="eyebrow mb-[1em]">{c.label}</div>
              <p class:list={['font-display italic font-medium leading-[1.25] text-ink text-[clamp(1.6rem,4.4cqw,2.4rem)]', c.body && 'mb-[0.9em]']}>{c.oversized}</p>
              {c.body && <p class="font-display leading-[1.65] text-ink text-[clamp(1.05rem,2.4cqw,1.2rem)]">{c.body}</p>}
            </div>
          </div>
        </Section>

        {/* QUOTE BAND · olive (photo-10: emerald wall) */}
        {c.bandAfter && (
          <Section mode="olive" data-reveal="lift" class="relative h-[clamp(380px,60cqw,600px)] w-full overflow-hidden">
            <Image src={photo10} alt="" widths={[800, 1400, 2400]} sizes="100vw" class="absolute inset-0 h-full w-full object-cover" />
            <div class="pointer-events-none absolute inset-0" style={bandScrim} />
            <div class="absolute bottom-0 left-0 right-0 p-[6cqw] text-center">
              <p class="mx-auto max-w-[32em] font-display italic leading-[1.5] text-ink text-[clamp(1.2rem,3.2cqw,1.7rem)]">
                Jeremiah 29:11 has been a constant reminder that God has a plan for their lives.
              </p>
            </div>
          </Section>
        )}
      </>
    ))
  }

  <!-- CLOSING · burlap (no image; alternates) -->
  <Section mode="burlap" data-reveal="lift" class="px-[6cqw] pb-[16cqw] pt-[14cqw] text-center">
    <p class="font-display italic text-ink text-[clamp(1.8rem,5cqw,2.6rem)]">Slegs goeie besluite</p>
  </Section>

  <Footer />
</Base>
