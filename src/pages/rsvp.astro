---
import Base from '../layouts/Base.astro';
import Section from '../components/site/Section.astro';
import Grid from '../components/site/Grid.astro';
import PageIntro from '../components/site/PageIntro.astro';
import Nav from '../components/site/Nav.astro';
import Footer from '../components/site/Footer.astro';
import RsvpForm from '../components/site/RsvpForm';
import banner from '../assets/photos/gallery/g-22.jpg';
import { PAYMENT_DEADLINE, RSVP_DEADLINE } from '../lib/pricing';

export const prerender = true;
---

<Base
  title="RSVP · Pieter & Joanique"
  description="RSVP for Pieter and Joanique's wedding weekend at Tshikwalo Game Lodge. Tell us who is coming and which nights you are staying, and your total is worked out as you go."
>
  <Nav />

  <PageIntro
    kicker="RSVP"
    title="Will you"
    flourish="join us?"
    caption="Hand in hand"
    lead="We would love to know whether you can be there, and which nights you will stay with us. Your household's total is worked out for you as you go."
    photo={banner}
    alt="Pieter and Joanique walking away hand in hand along a green gallery wall of framed prints."
    ratio="5/6"
    position="50% 50%"
    anchor
    detail="Saturday 14 November 2026"
    facts={[
      { label: 'Ceremony', value: 'Saturday 14 November, 15:00' },
      { label: 'Stay', value: 'Friday & Saturday, or Saturday only' },
      { label: 'Payment', value: `EFT by ${PAYMENT_DEADLINE}` },
    ]}
  >
    <p slot="foot" class="m-0 max-w-[44ch] font-display italic text-lead text-ink">Kindly respond by {RSVP_DEADLINE}.</p>
  </PageIntro>

  <!-- FORM · linen, columns 3–9 -->
  <Section mode="linen" class="pb-20 lg:pb-28">
    <Grid>
      <div class="border-t border-rule pt-10 lg:col-start-3 lg:col-span-7 lg:pt-14">
        <div class="max-w-[600px]">
          <noscript>
            <p class="mb-8 font-display text-lead text-ink">
              Having trouble with the form? Send your response to Pieter on{' '}
              <a href="tel:+27837980144" class="text-accent underline underline-offset-[0.2em]">083 798 0144</a> and he will sort it
              out with you. Prices and banking details are on{' '}
              <a href="/the-weekend#payment" class="text-accent underline underline-offset-[0.2em]">The Weekend</a>.
            </p>
          </noscript>
          <RsvpForm client:load />
        </div>
      </div>
    </Grid>
  </Section>

  <Footer />
</Base>
