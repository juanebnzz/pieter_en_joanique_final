---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Nav from '../components/site/Nav.astro';
import Footer from '../components/site/Footer.astro';
import RsvpForm from '../components/site/RsvpForm';
import banner from '../assets/photos/photo-12.jpg';
import { RSVP_DEADLINE } from '../lib/pricing';

export const prerender = true;
---

<Base title="RSVP — Pieter & Joanique">
  <Nav />

  <div class="max-h-[340px] w-full overflow-hidden" style="aspect-ratio:16/9;">
    <Image src={banner} alt="" widths={[640, 1024, 1600]} sizes="100vw" loading="eager" class="block h-full w-full object-cover" />
  </div>

  <div class="mx-auto max-w-[600px] px-[6cqw]">
    <section class="pb-[1em] pt-[2.4em] text-center">
      <h1 class="mb-[0.5em] font-display font-medium text-brand-ink text-[clamp(2.4rem,9cqw,3.2rem)]">RSVP</h1>
      <p class="mb-[1.4em] font-body text-[0.95rem] text-brand-muted">Kindly respond by {RSVP_DEADLINE}</p>
      <p class="font-display italic text-brand-ink text-[clamp(1.1rem,2.8cqw,1.25rem)]">Slegs goeie besluite</p>
    </section>

    <RsvpForm client:load />
  </div>

  <Footer />
</Base>
