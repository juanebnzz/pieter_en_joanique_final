---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Section from '../components/site/Section.astro';
import Nav from '../components/site/Nav.astro';
import Footer from '../components/site/Footer.astro';
import RsvpForm from '../components/site/RsvpForm';
import banner from '../assets/photos/photo-12.jpg';
import { RSVP_DEADLINE } from '../lib/pricing';

export const prerender = true;
---

<Base title="RSVP — Pieter & Joanique">
  <Nav />

  <!-- BANNER · olive (engagement imagery) -->
  <Section mode="olive" class="max-h-[340px] w-full overflow-hidden" style="aspect-ratio:16/9;">
    <Image src={banner} alt="" widths={[640, 1024, 1600]} sizes="100vw" loading="eager" class="block h-full w-full object-cover" />
  </Section>

  <!-- HEADING · burlap -->
  <Section mode="burlap" class="px-[6cqw] py-[2.4em] text-center">
    <div class="mx-auto max-w-[600px]">
      <h1 class="mb-[0.5em] font-display font-medium text-ink text-[clamp(2.4rem,9cqw,3.2rem)]">RSVP</h1>
      <p class="mb-[1.4em] font-body text-[0.95rem] text-ink">Kindly respond by {RSVP_DEADLINE}</p>
      <p class="font-display italic text-ink text-[clamp(1.1rem,2.8cqw,1.25rem)]">Slegs goeie besluite</p>
    </div>
  </Section>

  <!-- FORM · linen -->
  <Section mode="linen" class="px-[6cqw] pt-[2.4em]">
    <div class="mx-auto max-w-[600px]">
      <RsvpForm client:load />
    </div>
  </Section>

  <Footer />
</Base>
