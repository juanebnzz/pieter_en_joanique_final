---
// Tafelplasings: the page the QR code on the wedding stationery opens.
// Standalone on purpose (no Nav/Footer) so guests land straight on "find your seat".
// To move a guest, edit the TABLES list in the script at the bottom.
export const prerender = true;
---
<!doctype html>
<html lang="af">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<meta name="robots" content="noindex">
<meta name="theme-color" content="#302E2C">
<link rel="icon" href="/favicon.svg" type="image/svg+xml">
<title>Pieter &amp; Joanique Tafelplasings</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Bodoni+Moda:ital,opsz,wght@0,6..96,400;0,6..96,500;1,6..96,400&family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;1,400;1,500&family=Jost:wght@400;500&display=swap">
<style is:global>
/* Layout: an escort-card table. Espresso cover band, then a linen "card table" where you find your name, then all ten tables as a ruled ledger. Single deliberate light look, like printed stationery. */
:root {
  --espresso: #302E2C;
  --cinnamon: #875F45;
  --olive: #5B5546;
  --burlap: #BCB3A6;
  --linen: #F8F7F3;
  --paper: #FFFFFF;
  --ink-soft: #6E675C;
  --display: "Bodoni Moda", "Didot", "Bodoni 72", Georgia, serif;
  --serif: "Cormorant Garamond", "Garamond", "Times New Roman", serif;
  --sans: "Jost", "Futura", "Avenir Next", system-ui, sans-serif;
  color-scheme: light;
}
* { box-sizing: border-box; }
body {
  margin: 0;
  background: var(--linen);
  color: var(--espresso);
  font-family: var(--serif);
  font-size: 18px;
  line-height: 1.5;
  -webkit-font-smoothing: antialiased;
}
body::before {
  content: ""; position: fixed; inset: 0 0 auto;
  height: env(safe-area-inset-top, 0px); z-index: 10; background: var(--espresso);
}
.wrap {
  max-width: 560px; margin: 0 auto;
  padding-left: max(20px, env(safe-area-inset-left, 0px));
  padding-right: max(20px, env(safe-area-inset-right, 0px));
}
.kicker {
  font-family: var(--sans); font-size: 11px; font-weight: 500;
  letter-spacing: .28em; text-transform: uppercase;
}

/* ---------- Cover band ---------- */
.hero { background: var(--espresso); color: var(--linen); }
.hero .wrap { padding-block: 56px 48px; text-align: center; display: grid; gap: 18px; justify-items: center; }
.hero .kicker { color: var(--burlap); }
.names {
  margin: 0; font-family: var(--display); font-weight: 400;
  font-size: clamp(40px, 12vw, 64px); line-height: 1.02; letter-spacing: -.01em;
  text-wrap: balance;
}
.names .amp { display: block; font-family: var(--serif); font-style: italic; font-size: .62em; color: var(--burlap); margin: .06em 0; }
.rule { display: flex; align-items: center; gap: 12px; width: 100%; max-width: 260px; color: var(--burlap); }
.rule::before, .rule::after { content: ""; flex: 1; height: 1px; background: currentColor; opacity: .6; }
.rule span { font-family: var(--serif); font-style: italic; font-size: 22px; color: var(--linen); }
.hero .when { font-family: var(--serif); font-style: italic; font-size: 17px; color: var(--burlap); margin: 0; }

.hero .names, .hero .rule, .hero .kicker, .hero .when { animation: rise .9s cubic-bezier(.2,.7,.2,1) both; }
.hero .names { animation-delay: .08s; }
.hero .rule { animation-delay: .18s; }
.hero .when { animation-delay: .26s; }
@keyframes rise { from { opacity: .001; transform: translateY(10px); } to { opacity: 1; transform: none; } }

/* ---------- Find your seat ---------- */
.find .wrap { padding-block: 44px 8px; display: grid; gap: 14px; }
.find .kicker { color: var(--cinnamon); }
.find h2 { margin: 0; font-family: var(--display); font-weight: 400; font-size: 30px; line-height: 1.15; text-wrap: balance; }
.field { position: relative; margin-top: 6px; }
.field input {
  width: 100%; border: 0; border-bottom: 1px solid var(--espresso); border-radius: 0;
  background: transparent; color: var(--espresso);
  font-family: var(--serif); font-size: 26px; font-style: italic;
  padding: 8px 44px 10px 0; outline: none; -webkit-appearance: none; appearance: none;
}
.field input::placeholder { color: var(--burlap); }
.field input:focus-visible { border-bottom-color: var(--cinnamon); box-shadow: 0 1px 0 var(--cinnamon); }
.clear {
  position: absolute; right: 0; bottom: 8px; width: 36px; height: 36px;
  border: 0; background: transparent; color: var(--olive); font-size: 22px; cursor: pointer; border-radius: 0;
}
.clear:focus-visible { outline: 1px solid var(--cinnamon); }
.hint { margin: 0; font-size: 16px; color: var(--ink-soft); font-style: italic; }

/* Escort card */
.results { display: grid; gap: 14px; margin-top: 10px; }
.card {
  position: relative; background: var(--paper); border: 1px solid var(--espresso);
  padding: 34px 24px 28px; text-align: center; display: grid; gap: 6px; justify-items: center;
  animation: card .6s cubic-bezier(.2,.7,.2,1) both;
}
.card::before { content: ""; position: absolute; inset: 6px; border: 1px solid var(--burlap); pointer-events: none; }
@keyframes card { from { opacity: .001; transform: translateY(14px) rotate(-.6deg); } to { opacity: 1; transform: none; } }
.card .kicker { color: var(--olive); }
.card .who { font-family: var(--serif); font-style: italic; font-size: 30px; line-height: 1.1; margin: 4px 0 0; }
.card .at { font-family: var(--sans); font-size: 11px; letter-spacing: .28em; text-transform: uppercase; color: var(--ink-soft); margin-top: 10px; }
.card .num { font-family: var(--display); font-size: 96px; line-height: .9; color: var(--cinnamon); font-variant-numeric: lining-nums; }
.plan { width: 100%; max-width: 380px; margin-top: 12px; }
.plan svg { display: block; width: 100%; height: auto; }
.mates { margin: 4px 0 0; font-size: 17px; color: var(--olive); text-wrap: balance; }
.jump {
  margin-top: 10px; background: transparent; border: 0; border-bottom: 1px solid var(--cinnamon);
  color: var(--cinnamon); font-family: var(--sans); font-size: 12px; letter-spacing: .2em; text-transform: uppercase;
  padding: 6px 0; cursor: pointer; border-radius: 0;
}
.jump:focus-visible, .pick:focus-visible, summary:focus-visible { outline: 1px solid var(--cinnamon); outline-offset: 3px; }

/* Several matches */
.choose { margin: 0; font-size: 18px; }
.picks { display: grid; gap: 0; border-top: 1px solid var(--burlap); }
.pick {
  display: grid; grid-template-columns: 64px 1fr; gap: 14px; align-items: center; text-align: left;
  background: transparent; border: 0; border-bottom: 1px solid var(--burlap); padding: 14px 0; cursor: pointer;
  color: var(--espresso); font-family: var(--serif); font-size: 17px; border-radius: 0;
}
.pick b { font-family: var(--display); font-weight: 400; font-size: 34px; color: var(--cinnamon); line-height: 1; }
.pick span { min-width: 0; }
.pick small { display: block; font-family: var(--sans); font-size: 10.5px; letter-spacing: .24em; text-transform: uppercase; color: var(--ink-soft); }
.pick:hover { background: rgba(188,179,166,.18); }
.none { border-top: 1px solid var(--burlap); border-bottom: 1px solid var(--burlap); padding: 18px 0; margin: 0; font-size: 18px; }

/* ---------- All tables ledger ---------- */
.ledger .wrap { padding-block: 48px 40px; display: grid; gap: 16px; }
.ledger .kicker { color: var(--cinnamon); }
.ledger h2 { margin: 0; font-family: var(--display); font-weight: 400; font-size: 26px; }
.list { border-top: 1px solid var(--espresso); }
details { border-bottom: 1px solid var(--burlap); }
summary {
  list-style: none; cursor: pointer; display: grid; grid-template-columns: 58px 1fr auto; align-items: baseline;
  gap: 12px; padding: 16px 0;
}
summary::-webkit-details-marker { display: none; }
summary .n { font-family: var(--display); font-size: 30px; line-height: 1; font-variant-numeric: lining-nums; }
summary .t { font-family: var(--sans); font-size: 11px; letter-spacing: .26em; text-transform: uppercase; }
summary .c { font-style: italic; font-size: 15px; color: var(--ink-soft); }
summary .c::after { content: " +"; font-style: normal; font-family: var(--sans); color: var(--olive); }
details[open] summary .c::after { content: " \2013"; }
details.mine summary .n, details.mine summary .t { color: var(--cinnamon); }
details.mine { background: linear-gradient(90deg, rgba(135,95,69,.08), transparent 70%); }
.guests { margin: 0; padding: 0 0 18px 70px; list-style: none; display: flex; flex-wrap: wrap; gap: 4px 18px; font-size: 19px; }
.guests li.me { color: var(--cinnamon); font-weight: 600; }
.guests li.extra { font-style: italic; color: var(--olive); }

/* ---------- Footer ---------- */
footer .wrap { padding-block: 28px 56px; text-align: center; display: grid; gap: 8px; justify-items: center; border-top: 1px solid var(--burlap); }
footer p { margin: 0; font-style: italic; font-size: 20px; }
footer .kicker { color: var(--ink-soft); }

@media (prefers-reduced-motion: reduce) {
  *, *::before, *::after { animation: none !important; transition: none !important; scroll-behavior: auto !important; }
}
</style>
</head>
<body>
<header class="hero">
  <div class="wrap">
    <div class="kicker">Saterdag 14 November 2026</div>
    <h1 class="names">Pieter <span class="amp">&amp;</span> Joanique</h1>
    <div class="rule"><span>Tafelplasings</span></div>
    <p class="when">Tshikwalo Game Lodge, Dinokeng</p>
  </div>
</header>

<main>
  <section class="find" aria-labelledby="find-h">
    <div class="wrap">
      <div class="kicker">Vind jou plek</div>
      <h2 id="find-h">By watter tafel sit jy vanaand?</h2>
      <div class="field">
        <label for="q" class="kicker" style="position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0)">Tik jou naam</label>
        <input id="q" type="search" placeholder="Tik jou naam…" autocomplete="off" autocapitalize="words" spellcheck="false" enterkeyhint="search">
        <button class="clear" id="clear" type="button" aria-label="Maak skoon" hidden>&times;</button>
      </div>
      <p class="hint" id="hint">Net jou voornaam is genoeg. Of blaai hieronder deur al tien tafels.</p>
      <div class="results" id="results" aria-live="polite"></div>
    </div>
  </section>

  <section class="ledger" aria-labelledby="all-h">
    <div class="wrap">
      <div class="kicker">Al tien tafels</div>
      <h2 id="all-h">Die gastelys</h2>
      <div class="list" id="list"></div>
    </div>
  </section>
</main>

<footer>
  <div class="wrap">
    <p>Ons is so bly jy is hier.</p>
    <div class="kicker">Pieter &amp; Joanique</div>
  </div>
</footer>

<script is:inline>
// ---- The data: one object per table, straight from the seating sheet ----
// "extra" holds the names that were in brackets on the sheet.
const TABLES = [
  { n: 1,  guests: ["Madeleine","Iggie","Arnu","Amorette","Ouma Meish","Oupa Jan","Marinda","Louis"] },
  { n: 2,  guests: ["Karen","Nicolaas","Ouma Thillie","Diani","Willem","Sandra"] },
  { n: 3,  guests: ["Scott","Erla","Henry","Karen","Marina"], extra: ["Eden","Simeon","Ruah"] },
  { n: 4,  guests: ["Paul","Lizelle","Solly","Hanneke","Wynand","Su-lize","Aldrik"] },
  { n: 5,  guests: ["Jacques","Elzaan","Wihan","Delainey","Quinton","Caelynne","Nicolaas","Michelle"] },
  { n: 6,  guests: ["Sonja","Charl","AC","Simoné","Johan","Stephanie","Lafren Span"], extra: ["Abri","Elrene","Eliana"] },
  { n: 7,  guests: ["Zander","Charmonix","Manie","Stephanie","Philcu","Chanté","Reinhardt","Annécha"] },
  { n: 8,  guests: ["Melissa","Niël","Juané","Riki-Jay","Hanlie","Tessa","Rikus","Ion"] },
  { n: 9,  guests: ["Ruan","Diané","LJ","Lá Vonne","Jackie","Karen","Mzamo","Mia","Mzamo"] },
  { n: 10, guests: ["Jack","Christi","Zante","Gizelle","Armich","Lené","Frans","Luca"] }
];

// Everyone at a table, in sheet order.
const everyone = t => [...t.guests, ...(t.extra || [])];

// Make "Niël", "niel" and "NIEL" all match: strip accents, lowercase, drop punctuation.
const norm = s => s.normalize("NFD").replace(/[̀-ͯ]/g, "").toLowerCase().replace(/[^a-z ]/g, "");

const $ = id => document.getElementById(id);
const q = $("q"), results = $("results"), list = $("list"), clearBtn = $("clear"), hint = $("hint");
const pad = n => String(n).padStart(2, "0");
const el = (tag, cls, text) => { const e = document.createElement(tag); if (cls) e.className = cls; if (text != null) e.textContent = text; return e; };

// ---- Build the ledger of all tables ----
function buildList(mine) {
  list.innerHTML = "";
  TABLES.forEach(t => {
    const d = el("details"); d.id = "tafel-" + t.n;
    if (mine && mine.table === t.n) { d.classList.add("mine"); d.open = true; }
    const s = el("summary");
    s.append(el("span", "n", pad(t.n)), el("span", "t", "Tafel " + t.n), el("span", "c", everyone(t).length + " gaste"));
    const ul = el("ul", "guests");
    everyone(t).forEach((name, i) => {
      const li = el("li", null, name);
      if (i >= t.guests.length) li.classList.add("extra");
      if (mine && mine.table === t.n && mine.index === i) li.classList.add("me");
      ul.append(li);
    });
    d.append(s, ul); list.append(d);
  });
}

// ---- Draw the round table, names placed around it ----
function plan(t, meIndex) {
  const names = everyone(t), n = names.length;
  const W = 380, H = 340, cx = W / 2, cy = H / 2;
  const NS = "http://www.w3.org/2000/svg";
  const svg = document.createElementNS(NS, "svg");
  svg.setAttribute("viewBox", `0 0 ${W} ${H}`);
  svg.setAttribute("role", "img");
  svg.setAttribute("aria-label", `Tafel ${t.n}: ${names.join(", ")}`);
  const add = (tag, attrs, text) => {
    const e = document.createElementNS(NS, tag);
    for (const k in attrs) e.setAttribute(k, attrs[k]);
    if (text != null) e.textContent = text;
    svg.append(e); return e;
  };
  add("circle", { cx, cy, r: 62, fill: "#302E2C" });
  add("circle", { cx, cy, r: 55, fill: "none", stroke: "#BCB3A6", "stroke-width": .75 });
  add("text", { x: cx, y: cy - 12, "text-anchor": "middle", fill: "#BCB3A6", "font-family": "Jost, sans-serif", "font-size": 9, "letter-spacing": 2.5 }, "TAFEL");
  add("text", { x: cx, y: cy + 26, "text-anchor": "middle", fill: "#F8F7F3", "font-family": "'Bodoni Moda', Georgia, serif", "font-size": 38 }, t.n);
  names.forEach((name, i) => {
    const a = -Math.PI / 2 + (i / n) * Math.PI * 2;
    const sx = cx + Math.cos(a) * 82, sy = cy + Math.sin(a) * 82;
    const isMe = i === meIndex;
    add("circle", { cx: sx, cy: sy, r: isMe ? 7 : 5, fill: isMe ? "#875F45" : "#F8F7F3", stroke: isMe ? "#875F45" : "#5B5546", "stroke-width": 1 });
    const tx = cx + Math.cos(a) * 100, ty = cy + Math.sin(a) * 100;
    const anchor = Math.cos(a) > .25 ? "start" : Math.cos(a) < -.25 ? "end" : "middle";
    const dy = Math.sin(a) > .6 ? 12 : Math.sin(a) < -.6 ? -2 : 5;
    add("text", {
      x: tx, y: ty + dy, "text-anchor": anchor,
      fill: isMe ? "#875F45" : "#302E2C",
      "font-family": "'Cormorant Garamond', Georgia, serif",
      "font-size": isMe ? 17 : 15, "font-weight": isMe ? 600 : 400,
      "font-style": i >= t.guests.length ? "italic" : "normal"
    }, name);
  });
  return svg;
}

// ---- The escort card for one person ----
function showCard(m) {
  const t = TABLES.find(x => x.n === m.table);
  const card = el("div", "card");
  card.append(
    el("div", "kicker", "Welkom"),
    el("p", "who", m.name),
    el("div", "at", "Jy sit by"),
    el("div", "num", t.n)
  );
  const p = el("div", "plan"); p.append(plan(t, m.index)); card.append(p);
  const others = everyone(t).filter((_, i) => i !== m.index);
  card.append(el("p", "mates", "Saam met " + others.slice(0, -1).join(", ") + " en " + others.slice(-1)));
  const jump = el("button", "jump", "Wys op die gastelys"); jump.type = "button";
  jump.onclick = () => $("tafel-" + t.n).scrollIntoView({ behavior: "smooth", block: "center" });
  card.append(jump);
  results.innerHTML = ""; results.append(card);
  buildList(m);
}

// ---- Search as you type ----
function search() {
  const raw = q.value.trim(), v = norm(raw);
  clearBtn.hidden = !raw;
  results.innerHTML = "";
  if (v.length < 2) { hint.hidden = false; buildList(); return; }
  hint.hidden = true;

  const found = [];
  TABLES.forEach(t => everyone(t).forEach((name, index) => {
    const nn = norm(name);
    if (nn.startsWith(v) || nn.split(" ").some(w => w.startsWith(v))) found.push({ name, table: t.n, index, exact: nn === v });
  }));
  // An exact name match beats a partial one ("Karen" over "Karena").
  const exact = found.filter(f => f.exact);
  const matches = exact.length ? exact : found;

  if (!matches.length) {
    const p = el("p", "none");
    p.append("Ons kon nie ", el("em", null, "“" + raw + "”"), " vind nie. Probeer net jou voornaam, of vra gerus een van die gashere.");
    results.append(p); buildList(); return;
  }
  if (matches.length === 1) { showCard(matches[0]); return; }

  // Several people share the name: show who sits with each so they can recognise their table.
  results.append(el("p", "choose", `Daar is ${matches.length} gaste met die naam. Kies die tafel met mense wat jy ken:`));
  const picks = el("div", "picks");
  matches.forEach(m => {
    const t = TABLES.find(x => x.n === m.table);
    const b = el("button", "pick"); b.type = "button";
    const span = el("span");
    span.append(el("small", null, m.name + " · Tafel " + t.n), everyone(t).filter((_, i) => i !== m.index).slice(0, 4).join(", ") + "…");
    b.append(el("b", null, t.n), span);
    b.onclick = () => showCard(m);
    picks.append(b);
  });
  results.append(picks); buildList();
}

q.addEventListener("input", search);
clearBtn.addEventListener("click", () => { q.value = ""; search(); q.focus(); });

// A link ending in #tafel-5 opens straight on that table.
function fromHash() {
  const m = /^#tafel-(\d+)$/.exec(location.hash);
  if (m) { const d = $("tafel-" + m[1]); if (d) { d.open = true; d.scrollIntoView({ block: "center" }); } }
}
buildList();
fromHash();
window.addEventListener("hashchange", fromHash);
</script>
</body>
</html>
