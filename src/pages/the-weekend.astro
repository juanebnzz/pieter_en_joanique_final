---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Section from '../components/site/Section.astro';
import Grid from '../components/site/Grid.astro';
import DetailRows from '../components/site/DetailRows.astro';
import PageIntro from '../components/site/PageIntro.astro';
import Nav from '../components/site/Nav.astro';
import Footer from '../components/site/Footer.astro';
import introPhoto from '../assets/photos/gallery/g-16.jpg';
import venueDrawing from '../assets/illustrations/ceremony-venue.png';
import {
  BANK_DETAILS,
  CHILD_PER_NIGHT_CENTS,
  CONSERVATION_FEE_CENTS,
  CONSERVATION_FEE_NOTE,
  GAME_DRIVE_CENTS,
  PAYMENT_DEADLINE,
  RSVP_DEADLINE,
  STAY_OPTIONS,
  formatRand,
} from '../lib/pricing';

export const prerender = true;

/*
 * The "magazine" direction (weekend-variations.html · C), with the intro kept
 * in the same family as every other inner page so the site opens consistently.
 * Movements: intro → the three days side by side as a programme → the ceremony
 * pavilion, drawn in ink, at a modest size beside the lodge details → prices at
 * poster scale on burlap → the practicals as an at-a-glance strip → the ask on
 * olive. Bodoni (font-statement) is reserved for day names and prices, as on
 * the home page; everything else is the site's Cormorant / Jost pairing.
 */

type Row = { time: string; event: string; ceremony?: boolean };
const days: { day: string; date: string; rows: Row[] }[] = [
  {
    day: 'Friday',
    date: '13 November',
    rows: [
      { time: '14:00', event: 'Guests arrive' },
      { time: '18:00', event: 'Bonfire and burger night' },
    ],
  },
  {
    day: 'Saturday',
    date: '14 November',
    rows: [
      { time: '08:00', event: 'Breakfast for Friday guests' },
      { time: '11:00', event: 'Saturday guests arrive' },
      { time: '14:30 for 15:00', event: 'Ceremony', ceremony: true },
      { time: '16:00', event: 'Canapés' },
      { time: '18:00', event: 'Reception' },
      { time: '23:30', event: 'Last dance' },
    ],
  },
  {
    day: 'Sunday',
    date: '15 November',
    rows: [
      { time: '08:00', event: 'Breakfast for all guests' },
      { time: '10:00', event: 'Check-out' },
    ],
  },
];

// At a glance — six short cells. Every fact once.
const glance = [
  { label: 'Check-in', text: 'Friday from 14:00, or Saturday from 11:00. Saturday night at the lodge is part of the invitation for every guest.' },
  { label: 'Check-out', text: 'Sunday at 10:00, after breakfast.' },
  { label: 'Dress code', text: 'Semi-formal, earth-toned and summery. Please avoid black, white, red and purple.' },
  { label: 'Food & drink', text: 'A cash bar and The Roots restaurant, all weekend. No outside food or drinks, please.' },
  { label: 'Getting there', text: 'Directions are in the Maps link above. The reserve gates close in the evening, so please arrive in daylight.' },
  {
    label: 'In between',
    text: `A three-hour game drive, free for weekend guests (${formatRand(GAME_DRIVE_CENTS)} per person if you only stay Saturday), the pool, and the boma and bonfire after the reception.`,
  },
];

const tiers = [
  { title: 'Friday & Saturday', ...STAY_OPTIONS.friday_saturday },
  { title: 'Saturday only', ...STAY_OPTIONS.saturday },
];

const kicker = 'eyebrow m-0 mb-6 lg:col-start-2 lg:col-span-2 lg:mb-0 lg:pr-6';
const content = 'lg:col-start-4 lg:col-span-8';
---

<Base
  title="The Weekend · Pieter & Joanique"
  description="The full programme for Pieter and Joanique's wedding weekend at Tshikwalo Game Lodge, 13 to 15 November 2026: times, prices, the game drive and how to pay."
>
  <Nav />

  <!-- 1 · INTRO · same family as every inner page; the date on the rule and in the programme rows, the script on a phrase (never on numerals) -->
  <PageIntro
    kicker="The Weekend"
    title="Three Days"
    flourish="in the bushveld"
    caption="Come along"
    lead="Join us at Tshikwalo Game Lodge, in the Dinokeng Game Reserve, as we celebrate the beginning of our marriage."
    photo={introPhoto}
    alt="Joanique pulling Pieter along by the hand across the green gallery, both laughing."
    ratio="5/6"
    position="50% 45%"
    anchor
    detail="Friday 13 to Sunday 15 November 2026"
    facts={[
      { label: 'Friday 13', value: 'Guests arrive from 14:00 · bonfire at 18:00' },
      { label: 'Saturday 14', value: 'The ceremony at 15:00 · reception at 18:00' },
      { label: 'Sunday 15', value: 'Breakfast together · check-out at 10:00' },
    ]}
  >
    <p slot="foot" class="m-0 max-w-[44ch] font-display italic text-lead text-ink">
      Please be seated for the ceremony from 14:30.
    </p>
  </PageIntro>

  <!-- 2 · THE PROGRAMME · three days side by side -->
  <Section mode="linen" data-reveal class="py-10 md:py-14 lg:py-20">
    <Grid class="gap-y-12 border-t border-rule pt-10 md:pt-12 lg:gap-x-12 lg:pt-16">
      {
        days.map((d) => (
          <div class="lg:col-span-4">
            <h2 class="m-0 mb-5">
              <span class="block font-statement text-[2.4rem] leading-none text-ink">{d.day}</span>
              <span class="eyebrow mt-3 block">{d.date}</span>
            </h2>
            {d.rows.map((r) =>
              r.ceremony ? (
                <div class="my-1 flex flex-col gap-y-1 border-t border-b border-accent py-4 sm:flex-row sm:items-baseline sm:gap-x-4 [&+*]:border-t-0">
                  <div class="font-body font-medium text-small text-accent sm:w-[8em] sm:flex-none">{r.time}</div>
                  <div class="min-w-0">
                    <div class="font-display font-medium text-title text-ink">{r.event}</div>
                    <a
                      href="/pieter-joanique-ceremony.ics"
                      download="Pieter-Joanique-Ceremony.ics"
                      class="mt-1 inline-flex min-h-[44px] items-center font-body font-medium text-small text-ink underline underline-offset-[0.15em] hover:opacity-75 sm:min-h-0"
                    >
                      Add to calendar →
                    </a>
                  </div>
                </div>
              ) : (
                <div class="flex flex-col gap-y-0.5 border-t border-rule py-3 sm:flex-row sm:items-baseline sm:gap-x-4">
                  <div class="font-body font-medium text-small text-ink sm:w-[8em] sm:flex-none">{r.time}</div>
                  <div class="font-display text-lead text-ink">{r.event}</div>
                </div>
              ),
            )}
          </div>
        ))
      }
    </Grid>
  </Section>

  <!-- 3 · WHERE · the ceremony pavilion, drawn in ink — a modest figure beside the lodge details -->
  <Section mode="linen" data-reveal class="pb-14 md:pb-20 lg:pb-24">
    <Grid class="gap-y-8 lg:items-center">
      <figure class="m-0 max-w-[320px] sm:max-w-[400px] lg:col-start-2 lg:col-span-4 lg:max-w-none">
        <Image
          src={venueDrawing}
          alt="Line drawing of the ceremony pavilion: a pitched timber roof on brick pillars, with an arched doorway between tall windows."
          widths={[480, 800, 1200]}
          sizes="(min-width: 1680px) 540px, (min-width: 1024px) 33vw, 400px"
          class="h-auto w-full"
        />
      </figure>
      <div class="lg:col-start-7 lg:col-span-5">
        <div class="eyebrow mb-4">Where we say I do</div>
        <h2 class="m-0 font-display font-medium text-title text-ink">Tshikwalo Game Lodge</h2>
        <p class="mt-3 max-w-[40ch] font-display text-lead text-ink">
          In the Dinokeng Game Reserve. The last stretch is a dirt road, fine for any car, with secure parking at the lodge.
        </p>
        <a
          href="https://maps.app.goo.gl/VG91Q6UzcwRK1Pd99"
          target="_blank"
          rel="noopener"
          class="mt-5 inline-flex min-h-[44px] items-center font-body font-medium text-small uppercase tracking-[0.14em] text-ink underline underline-offset-[0.3em] hover:opacity-75"
          >Open in Maps →</a
        >
      </div>
    </Grid>
  </Section>

  <!-- 4 · WHAT IT COSTS · prices at poster scale on burlap; banking collapsed -->
  <Section mode="burlap" id="payment" class="scroll-mt-8 py-14 md:py-16 lg:py-24">
    <Grid>
      <h2 class={kicker}>What It Costs</h2>
      <div class={content}>
        <div class="grid grid-cols-1 gap-10 sm:grid-cols-2 sm:gap-8">
          {
            tiers.map((t) => (
              <div>
                <p class="eyebrow m-0">{t.title}</p>
                <p class="m-0 mt-2 font-statement text-[clamp(3rem,6vw,5rem)] leading-none text-ink">
                  {formatRand(t.adultCents)}
                  <span class="ml-2 font-body font-medium text-small uppercase tracking-[0.14em] text-ink">per person</span>
                </p>
                <p class="m-0 mt-3 max-w-[38ch] font-body text-small leading-[1.6] text-ink">{t.smallPrint}</p>
              </div>
            ))
          }
        </div>

        <p class="mt-10 max-w-[64ch] font-body text-body text-ink">
          Staying the whole weekend includes the lodge's three-hour game drive, with snacks along the way. Saturday-only guests can add it for{' '}
          {formatRand(GAME_DRIVE_CENTS)} per person. If you are weighing it up, the full weekend includes the drive, Friday's bonfire
          dinner and a second night.
        </p>

        <p class="mt-6 max-w-[64ch] font-body text-body text-ink">
          Children under 2 stay free; ages 2 to 12 are {formatRand(CHILD_PER_NIGHT_CENTS)} per child per night. Your total is worked
          out for you on the RSVP form.
        </p>

        <!-- The conservation fee is the one line guests do not expect, so it gets the same poster treatment as the prices. -->
        <div class="mt-10 border-t border-ink pt-8">
          <p class="eyebrow m-0">Conservation fee</p>
          <p class="m-0 mt-2 font-statement text-[clamp(3rem,6vw,5rem)] leading-none text-ink">
            {formatRand(CONSERVATION_FEE_CENTS)}
            <span class="ml-2 font-body font-medium text-small uppercase tracking-[0.14em] text-ink">per household</span>
          </p>
          <p class="m-0 mt-3 max-w-[64ch] font-body text-body leading-[1.6] text-ink">{CONSERVATION_FEE_NOTE}</p>
        </div>

        <details id="banking" class="group mt-8 scroll-mt-8 border-t border-b border-ink">
          <summary class="flex min-h-[56px] cursor-pointer list-none items-center justify-between gap-4 py-3 font-display font-medium text-title text-ink [&::-webkit-details-marker]:hidden">
            Banking details
            <span aria-hidden="true" class="font-display text-[1.6rem] leading-none transition-transform duration-300 group-open:rotate-45">+</span>
          </summary>
          <div class="pb-6">
            <p class="mb-4 max-w-[64ch] font-body text-body text-ink">
              Accommodation is paid by EFT, directly to us, by {PAYMENT_DEADLINE}. Please use your initials and surname as the
              reference.
            </p>
            <DetailRows rows={BANK_DETAILS} />
          </div>
        </details>
      </div>
    </Grid>
  </Section>

  <!-- 5 · AT A GLANCE · six short cells in one strip -->
  <Section mode="linen" class="py-12 md:py-14 lg:py-16">
    <Grid>
      <dl class="m-0 grid grid-cols-2 gap-x-6 gap-y-8 lg:col-span-12 lg:grid-cols-6 lg:gap-x-8">
        {
          glance.map((g) => (
            <div>
              <dt class="eyebrow mb-2">{g.label}</dt>
              <dd class="m-0 font-body text-small leading-[1.6] text-ink">{g.text}</dd>
            </div>
          ))
        }
      </dl>
    </Grid>
  </Section>

  <!-- 6 · THE ASK · olive band -->
  <Section mode="olive" class="px-5 py-16 text-center md:px-10 lg:py-24">
    <p class="mx-auto mb-8 max-w-[30ch] font-display italic text-[clamp(1.75rem,3.5vw,2.6rem)] leading-[1.2] text-ink">
      Kindly respond by {RSVP_DEADLINE}.
    </p>
    <a
      href="/rsvp"
      class="inline-flex min-h-[52px] items-center justify-center border border-ink px-10 font-body font-medium text-[0.78rem] uppercase tracking-[0.18em] text-ink transition-colors hover:bg-ink hover:text-surface"
      >RSVP now</a
    >
  </Section>

  <Footer />
</Base>

<script>
  // Deep links to the money block (#payment from the RSVP page, #banking) open the banking disclosure.
  const banking = document.querySelector<HTMLDetailsElement>('#banking');
  const openIfLinked = () => {
    if (banking && /^#(payment|banking)$/.test(location.hash)) banking.open = true;
  };
  openIfLinked();
  window.addEventListener('hashchange', openIfLinked);
</script>
