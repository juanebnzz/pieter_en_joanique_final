---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Base from '../layouts/Base.astro';
import Section, { type Mode } from '../components/site/Section.astro';
import Nav from '../components/site/Nav.astro';
import Footer from '../components/site/Footer.astro';
import fridayPhoto from '../assets/photos/photo-9.jpg';
import saturdayPhoto from '../assets/photos/photo-6.jpg';
import sundayPhoto from '../assets/photos/photo-7.jpg';
import { BANK_DETAILS, GIFT_DETAILS, PAYMENT_DEADLINE } from '../lib/pricing';

export const prerender = true;

type Row = { time: string; event: string; ceremony?: boolean };
// Every day band photograph has white gallery walls, so bands are linen, and
// each timeline beneath sits on burlap. As on the home page, text blocks only
// ever alternate burlap / linen; olive is reserved for photographs and the footer.
const scrim = (pct: number, height: string) =>
  `height:${height};background:linear-gradient(to top, color-mix(in srgb, var(--color-surface) ${pct}%, transparent) 0%, color-mix(in srgb, var(--color-surface) 0%, transparent) 100%);`;
const days: { title: string; photo: ImageMetadata; mode: Mode; timelineMode: Mode; gradient: string; rows: Row[]; note: string | null }[] = [
  {
    title: 'Friday · 13 November',
    photo: fridayPhoto, // photo-9: white walls
    mode: 'linen',
    timelineMode: 'burlap',
    gradient: scrim(90, '65%'),
    rows: [
      { time: '14:00', event: 'Guests arrive' },
      { time: '18:00', event: 'Bonfire and burger night' },
    ],
    note: 'Friday night accommodation at Tshikwalo Game Lodge',
  },
  {
    title: 'Saturday · 14 November',
    photo: saturdayPhoto, // photo-6: white walls
    mode: 'linen',
    timelineMode: 'burlap',
    gradient: scrim(95, '70%'),
    rows: [
      { time: '08:00', event: 'Breakfast at the lodge restaurant, for Friday guests' },
      { time: '11:00', event: 'Saturday guests arrive' },
      { time: '14:30 for 15:00', event: 'Ceremony', ceremony: true },
      { time: '16:00', event: 'Canapés' },
      { time: '18:00', event: 'Reception' },
      { time: '23:30', event: 'Last dance' },
    ],
    note: 'Saturday night accommodation at Tshikwalo Game Lodge',
  },
  {
    title: 'Sunday · 15 November',
    photo: sundayPhoto, // photo-7: white walls
    mode: 'linen',
    timelineMode: 'burlap',
    gradient: scrim(85, '60%'),
    rows: [
      { time: '08:00', event: 'Breakfast for all guests' },
      { time: '10:00', event: 'Checkout' },
    ],
    note: null,
  },
];

const throughout = [
  'A complimentary game drive for guests staying from Friday',
  'The on-site restaurant is open all weekend for snacks and refreshments',
  'A cash bar is available throughout',
  'Bring swimwear for the pool',
  'After the reception, the boma and bonfire stay open',
];

const costs = [
  {
    title: 'Friday and Saturday — R2 100 per person',
    detail:
      'Friday dinner, Friday accommodation, Saturday breakfast, all wedding events, Saturday accommodation, Sunday breakfast, complimentary game drive.',
  },
  { title: 'Saturday only — R965 per person', detail: 'All wedding events, Saturday accommodation, Sunday breakfast.' },
  { title: 'Children', detail: 'Under 2 free. Ages 2 to 12, R270 per child per night.' },
  {
    title: 'Conservation fee — R100 per guest, paid at the gate',
    detail:
      'Dinokeng Game Reserve charges every guest a R100 conservation fee. You pay it at the reserve gate when you arrive. It is not part of your accommodation payment and does not go to Pieter and Joanique.',
  },
];

const goodToKnow = [
  'The venue is reached by a dirt road, suitable for all vehicles. Secure parking is provided.',
  'No outside food or drinks are permitted.',
  'A cash bar and the Tshikwalo "The Roots" restaurant are open all weekend.',
  'Dinokeng Game Reserve charges a R100 conservation fee per guest, paid at the gate on arrival.',
];

const inner = 'mx-auto max-w-[680px]';
const bodyText = 'font-display leading-[1.65] text-ink text-[clamp(1.05rem,2.4cqw,1.2rem)]';
---

<Base title="The Weekend — Pieter & Joanique">
  <Nav />

  <!-- INVITATION · burlap -->
  <Section mode="burlap" data-reveal class="px-[6cqw] py-[9cqw]">
    <div class={inner}>
      <div class="eyebrow mb-[1.2em]">The Invitation</div>
      <p class="font-display leading-[1.65] text-ink text-[clamp(1.2rem,2.8cqw,1.4rem)]">
        Join us for a weekend away in the beautiful Dinokeng Game Reserve, as we celebrate the beginning of
        Pieter and Joanique's marriage.
      </p>
    </div>
  </Section>

  {
    days.map((d) => (
      <>
        {/* DAY BAND · linen (white walls) */}
        <Section mode={d.mode} class="relative h-[40vh] max-h-[340px] min-h-[220px] w-full overflow-hidden">
          <Image src={d.photo} alt="" widths={[800, 1400, 2400]} sizes="100vw" class="absolute inset-0 h-full w-full object-cover" />
          <div class="pointer-events-none absolute bottom-0 left-0 right-0" style={d.gradient} />
          <div class="absolute bottom-0 left-0 right-0 pb-[0.9em] pr-[6cqw]" style="padding-left:max(6cqw,calc((100cqw - 680px) / 2));">
            <p class="font-display font-medium text-ink text-[clamp(2rem,7.5cqw,3rem)]">{d.title}</p>
          </div>
        </Section>

        {/* DAY TIMELINE · burlap / olive / burlap (no image; alternates) */}
        <Section mode={d.timelineMode} class="px-[6cqw] pb-[8cqw] pt-[3cqw]">
          <div class={inner}>
            {d.rows.map((r) => (
              <div class="flex flex-wrap gap-y-[0.3em] gap-x-[1.2em] border-t border-rule py-[0.9em]">
                <div class="min-w-[9.5em] flex-none whitespace-nowrap font-body font-medium text-[0.9rem] text-ink">{r.time}</div>
                <div class="flex-[1_1_200px] font-display text-ink text-[clamp(1.15rem,2.6cqw,1.35rem)]">
                  {r.event}
                  {r.ceremony && (
                    <span>
                      {' '}
                      —{' '}
                      <a
                        href="/pieter-joanique-ceremony.ics"
                        download="Pieter-Joanique-Ceremony.ics"
                        class="font-body font-medium text-[0.85rem] tracking-[0.02em] text-ink underline underline-offset-[0.15em] hover:opacity-75"
                      >
                        Add to calendar →
                      </a>
                    </span>
                  )}
                </div>
              </div>
            ))}
            {d.note && <p class="mt-[1.4em] font-display italic text-ink text-[clamp(1.05rem,2.4cqw,1.2rem)]">{d.note}</p>}
          </div>
        </Section>
      </>
    ))
  }

  <!-- THROUGHOUT · linen (no image; alternates) -->
  <Section mode="linen" data-reveal class="px-[6cqw] py-[6cqw]">
    <div class={inner}>
      <div class="eyebrow mb-[1.4em]">Throughout The Weekend</div>
      {throughout.map((t) => <div class:list={['border-t border-rule py-[0.9em]', bodyText]}>{t}</div>)}
    </div>
  </Section>

  <!-- STAYING · burlap (no image; alternates) -->
  <Section mode="burlap" data-reveal class="px-[6cqw] py-[6cqw]">
    <div class={inner}>
      <div class="eyebrow mb-[1.4em]">Staying With Us</div>
      <p class:list={['mb-[1.4em]', bodyText]}>
        Saturday night accommodation is compulsory, as we are booking out the entire venue. If you have other arrangements,
        please contact us directly and we will make the necessary adjustments.
      </p>
      {
        [
          ['Check-in', 'Friday from 14:00'],
          ['Check-out', 'Sunday at 10:00'],
        ].map(([k, v]) => (
          <div class="flex gap-[1.2em] border-t border-rule py-[0.9em]">
            <div class="min-w-[7.5em] flex-none font-body font-medium text-[0.9rem] text-accent">{k}</div>
            <div class="font-display text-ink text-[clamp(1.05rem,2.4cqw,1.2rem)]">{v}</div>
          </div>
        ))
      }
    </div>
  </Section>

  <!-- COSTS · linen (no image; alternates) -->
  <Section mode="linen" data-reveal class="px-[6cqw] py-[6cqw]">
    <div class={inner}>
      <div class="eyebrow mb-[1.4em]">What It Costs</div>
      {
        costs.map((c) => (
          <div class="border-t border-rule py-[1.4em]">
            <p class="mb-[0.5em] font-display font-medium text-ink text-[clamp(1.2rem,2.8cqw,1.4rem)]">{c.title}</p>
            <p class="font-body leading-[1.7] text-[0.95rem] text-ink">{c.detail}</p>
          </div>
        ))
      }

      <!-- HOW TO PAY · sits with the prices so the money information is in one place -->
      <div id="payment" class="mt-[2.4em] scroll-mt-[2em]">
        <div class="eyebrow mb-[1.2em]">How To Pay</div>
        <p class:list={['mb-[1.4em]', bodyText]}>
          Accommodation is paid by EFT, directly to Pieter and Joanique, by {PAYMENT_DEADLINE}. Please use your initials and
          surname as the reference.
        </p>
        <dl class="m-0">
          {
            BANK_DETAILS.map((r) => (
              <div class="flex justify-between gap-[1em] border-t border-rule py-[0.8em]">
                <dt class="font-body font-medium text-[0.85rem] text-ink">{r.label}</dt>
                <dd class="m-0 text-right font-body text-[0.95rem] text-ink">{r.value}</dd>
              </div>
            ))
          }
        </dl>
      </div>
    </div>
  </Section>

  <!-- GIFTS · burlap (no image; alternates) — kept apart from the accommodation payment block -->
  <Section mode="burlap" data-reveal class="px-[6cqw] py-[6cqw]">
    <div class={inner}>
      <div class="eyebrow mb-[1.4em]">A Gift</div>
      <p class:list={['mb-[1.4em]', bodyText]}>
        Having you with us is the greatest gift we could ask for. If you would like to bless us with something extra, the
        same account applies — with a different reference so it is kept apart from your accommodation payment.
      </p>
      <dl class="m-0">
        {
          GIFT_DETAILS.map((r) => (
            <div class="flex justify-between gap-[1em] border-t border-rule py-[0.8em]">
              <dt class="font-body font-medium text-[0.85rem] text-ink">{r.label}</dt>
              <dd class="m-0 text-right font-body text-[0.95rem] text-ink">{r.value}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </Section>

  <!-- GOOD TO KNOW · linen (no image; alternates) -->
  <Section mode="linen" data-reveal class="px-[6cqw] py-[6cqw]">
    <div class={inner}>
      <div class="eyebrow mb-[1.4em]">Good To Know</div>
      {goodToKnow.map((t) => <div class:list={['border-t border-rule py-[0.9em]', bodyText]}>{t}</div>)}
    </div>
  </Section>

  <!-- WHAT TO WEAR · burlap (no image; alternates) -->
  <Section mode="burlap" data-reveal class="px-[6cqw] py-[6cqw]">
    <div class={inner}>
      <div class="eyebrow mb-[1.4em]">What To Wear</div>
      <p class={bodyText}>
        The dress code is semi-formal. We are keeping things earth-toned and summery to suit the bush setting, so please
        avoid black, white, red and purple where possible.
      </p>
    </div>
  </Section>

  <!-- FINDING US · linen (no image; alternates) -->
  <Section mode="linen" data-reveal class="px-[6cqw] pb-[12cqw] pt-[6cqw]">
    <div class={inner}>
      <div class="eyebrow mb-[1.2em]">Finding Us</div>
      <a
        href="https://maps.app.goo.gl/VG91Q6UzcwRK1Pd99"
        target="_blank"
        rel="noopener"
        class="font-display italic text-ink underline underline-offset-[0.2em] hover:opacity-75 text-[clamp(1.2rem,2.8cqw,1.4rem)]"
        >Tshikwalo Game Lodge, Dinokeng Game Reserve →</a
      >
    </div>
  </Section>

  <Footer />
</Base>
